eval 'const st = r.state; r.setSeason("sommer"); window.__wetterSetzen("sunny"); r._naesseTakt(1e6); r.setTimeOfDay(0.5, "regler"); st.playerMesh.position.set(-280.4, r._voxelSurfaceY(-280.4, -1045.6) + 1, -1045.6); for (let i = 0; i < 300; i++) await __werkTakt(); return "ort";'
eval 'const mess = async (sek) => { const v = []; let t0 = r._gpuTsAtMs; const ende = performance.now() + sek * 1000; let n = 0; while (performance.now() < ende) { await __werkTakt(); n++; if (r._gpuTsAtMs !== t0) { t0 = r._gpuTsAtMs; v.push(r._gpuTsLast); } } v.sort((a, b) => a - b); const q = (p) => +v[Math.floor((v.length - 1) * p)].toFixed(3); return { n: v.length, bilder: n, med: q(0.5), p25: q(0.25), p75: q(0.75) }; }; const hat = typeof r._augeKetteZeichnen === "function"; const lagen = hat ? [["aus", true, false], ["G", false, false], ["F", false, true]] : [["main", false, false]]; const aus = {}; await mess(4); for (let rd = 0; rd < 3; rd++) for (const [n, a, f] of lagen) { r._augeAus = a; r._augeFeld = f; await mess(1.5); const m = await mess(11); (aus[n] = aus[n] || []).push(m); } r._augeAus = false; r._augeFeld = false; return JSON.stringify({ kopf: hat ? "spike" : "main", ts: r.state.renderer.backend.trackTimestamp, dbuf: r.state.renderer.getDrawingBufferSize(new THREE.Vector2()).toArray(), aus });'
