+# DER WÄCHTER (oben, `--waechter`): fork + exec einer Bash — er steht in Windows NICHT unter gpu-lauf (der fork-Stumpf endet nach dem
+# exec) und überlebt so ein `taskkill /F /T` auf gpu-lauf; er hält keine Ausgabe offen (sonst wartete jeder Leser der Ausgabe auf ihn)
+STOP="$GPU_SCHLOSS.stop.$$"
+rm -f "$STOP"
+GPU_SCHLOSS=$GPU_SCHLOSS GPU_HOOK_LOG=$GPU_HOOK_LOG GPU_LAUF_NAME=$NAME GPU_LAUF_ART=$ART GPU_LAUF_MAX_S=$MAX GPU_LAUF_PLATZ=$GPU_PLATZ \
+    bash "${BASH_SOURCE[0]}" --waechter $$ "$KIND" "$GPU_ICH_PID" >/dev/null 2>&1 </dev/null &
 WACHE=$!
+# TERM/INT: der Wächter fällt den Baum und löst das Schloss, gpu-lauf wartet auf ihn
+ende() {
+    touch "$STOP"
+    wait "$WACHE" 2>/dev/null
+    exit "$1"
+}
+trap 'ende 130' INT
+trap 'ende 143' TERM
 wait "$KIND"
 rc=$?
-kill "$WACHE" 2>/dev/null
+wait "$WACHE" 2>/dev/null
+[ $? = 3 ] && echo "GPU-LAUF: ein Glied des Baums überlebt — das Schloss bleibt bei ihm, bis es endet" >&2
