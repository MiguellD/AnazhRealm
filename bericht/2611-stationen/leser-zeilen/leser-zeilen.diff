+            vor = KEY_VOR_REGEX.has(w) ? "kw:" + w : "ident";
+            continue;
+        }
+        if (/[0-9]/.test(c)) { while (i < n && /[\w.]/.test(src[i])) i++; vor = "ident"; continue; }
+        if (c === ")" || c === "]") { i++; vor = "ident"; continue; }
+        if (/\s/.test(c)) { i++; continue; }
+        i++; vor = "punct";
+    }
+    return out;
+}
+
+// ───────── DIE ANGABEN: datei:zeile[–zeile] mit dem Namen danach (oder davor) ─────────
+const ANGABE = /(?<![\w./-])((?:[\w.-]+\/)*[\w-]+(?:\.[\w-]+)*\.(?:c?js|mjs|html)):(\d+)(?:\s*[–-]\s*:?(\d+))?/g;
+const NAME_NACH = /^\s+[`'"]?((?:[A-Za-z_$][\w$]*\.)*[A-Za-z_$][\w$]*)/;
+const NAME_VOR = /[`'"]?((?:[A-Za-z_$][\w$]*\.)*[A-Za-z_$][\w$]*)[`'"]?\s*\(\s*$/;
+const codeName = (w) => /[_$]/.test(w) || /[a-z][A-Z]/.test(w) || /^[A-Z][A-Z0-9_]{2,}$/.test(w) || /\./.test(w);
+function angaben(text) {
+    const r = [];
+    for (const m of text.matchAll(ANGABE)) {
+        const ende = m.index + m[0].length;
+        let name = null, wo = null;
+        const nach = NAME_NACH.exec(text.slice(ende, ende + 120));
+        if (nach && codeName(nach[1])) (name = nach[1]), (wo = "nach");
+        else {
+            const vor = NAME_VOR.exec(text.slice(Math.max(0, m.index - 120), m.index));
+            if (vor && codeName(vor[1])) (name = vor[1]), (wo = "vor");
+        }
+        r.push({ datei: m[1], zeile: +m[2], bis: m[3] ? +m[3] : null, name, wo, an: m.index, laenge: m[0].length, roh: m[0] });
+    }
+    return r;
+}
+
+// ───────── DAS URTEIL JE ANGABE gegen die Datei des Kopfs ─────────
+// Die neue Zeile kommt aus dem ANKER: der Kopf von main, auf dem die Angabe galt (der jüngste Stand der Datei bis zur Zeit, zu der
+// die Zeile der Station zuletzt geschrieben wurde — git blame —, auf dem die Zeile den Namen trägt; sonst bis zu 40 ältere und 10
+// jüngere Stände), und von dort die Zeile durch den Diff bis zum Kopf (git diff -U0): eine Zeile außerhalb jedes Hunks wandert um die
+// Summe davor, eine Zeile in einem Hunk sucht den Namen im neuen Hunk. Ohne Anker gilt nur die EINZIGE Fundstelle; mehrere ohne
+// Anker heißen mehrdeutig und werden nicht umgestellt.
+const wortRe = (w) => new RegExp("(?<![\\w$])" + w.split(".").pop().replace(/[$]/g, "\\$") + "(?![\\w$])");
+function traegt(zeilen, a, re) {
+    const von = a.zeile, bis = a.bis && a.bis >= a.zeile ? a.bis : a.zeile;
+    for (let z = von; z <= bis; z++) if (zeilen[z - 1] !== undefined && re.test(zeilen[z - 1])) return true;
+    return false;
+}
+function urteil(a, zeilen, anker = () => null) {
+    if (!zeilen) return { art: "fehlt", grund: "die Datei fehlt im Kopf" };
+    const re = wortRe(a.name);
+    const fund = [];
+    zeilen.forEach((t, k) => re.test(t) && fund.push(k + 1));
+    if (!fund.length) return { art: "fehlt", grund: "der Name steht nicht mehr in der Datei" };
+    const mit = (neu, wie) => ({ art: "verschoben", neu, neuBis: a.bis ? a.bis + (neu - a.zeile) : null, abstand: neu - a.zeile, wie });
+    // der Anker entscheidet zuerst — auch über „gleich“: trägt die alte Zeile den Namen nur zufällig (ein Kommentar, ein zweiter Ruf),
+    // zeigt die Angabe trotzdem auf eine andere Stelle als die, auf der sie galt
+    const k = anker(a, re);
+    if (k && k.neu && traegt(zeilen, { zeile: k.neu, bis: a.bis ? a.bis + (k.neu - a.zeile) : null }, re)) return k.neu === a.zeile ? { art: "gleich", wie: "Anker " + k.sha.slice(0, 8) } : mit(k.neu, "Anker " + k.sha.slice(0, 8));
+    if (traegt(zeilen, a, re)) return { art: "gleich" };
+    if (fund.length === 1) return mit(fund[0], "einzige Fundstelle");
+    return { art: "mehrdeutig", fund: fund.length, grund: (k ? "der Anker " + k.sha.slice(0, 8) + " trägt die Zeile, der Diff verlor sie" : "kein Anker") + ", " + fund.length + " Fundstellen" };
+}
+
+// eine Zeile durch die Hunks eines Diffs (-U0): [a, b, c, d] = @@ -a,b +c,d @@; liegt sie in einem Hunk, gilt unter den Zeilen des
+// neuen Hunks mit dem Namen die mit dem längsten gemeinsamen Anfang zur alten Zeile (`text`, die Signatur wuchs: `planetOrt(… aus)` →
+// `planetOrt(… aus, heimat)`), dann die nächste
+const anfang = (x, y) => { let k = 0; while (k < x.length && x[k] === y[k]) k++; return k; };
+function bilde(hunks, N, re, neu, text = "") {
+    let off = 0;
+    for (const [a, b, c, d] of hunks) {
+        if (b === 0) { if (N > a) { off += d; continue; } break; }
+        if (N < a) break;
+        if (N <= a + b - 1) {
+            const kand = [];
+            for (let k = c; k < c + d; k++) if (re.test(neu[k - 1] || "")) kand.push(k);
+            const soll = c + (N - a), t = String(text).trim(), g = (k) => anfang(t, (neu[k - 1] || "").trim());
+            kand.sort((x, y) => g(y) - g(x) || Math.abs(x - soll) - Math.abs(y - soll));
+            return kand.length ? kand[0] : null;
+        }
+        off += d - b;
+    }
+    return re.test(neu[N + off - 1] || "") ? N + off : null;
+}
+// DIE ZEILE DES ANKERS IM KOPF (Stichprobe 26.11.: k2-zusammenspiel.js:6110 `planet-core.js:2684 planetOrt` ging im Hunk an den
+// nächsten Namen, :2785 ein `throw` mit „planetOrt:“ im Text, nicht an die Funktion): die Zeile, die im Anker den Namen trägt (bei a–b
+// die erste im Bereich), WORTGLEICH im Kopf geht vor — genau eine, oder unter mehreren die, auf die der Diff zeigt (sonst die nächste
+// zu ihm); erst ohne wortgleiche Zeile gilt der Diff allein. Zurück die neue Anfangs-Zeile der Angabe (der Bereich wandert ganz).
+function ankerZeile(z, a, re, hunks, kopf) {
+    const bis = a.bis && a.bis >= a.zeile ? a.bis : a.zeile;
+    let L0 = a.zeile;
+    while (L0 < bis && !re.test(z[L0 - 1] || "")) L0++;
+    const text = (z[L0 - 1] || "").trim();
+    const diff = bilde(hunks, L0, re, kopf, text);
+    const gleich = [];
+    if (text) kopf.forEach((t, k) => t.trim() === text && gleich.push(k + 1));
+    let L1 = diff;
+    if (gleich.length === 1) L1 = gleich[0];
+    else if (gleich.length > 1) L1 = gleich.includes(diff) ? diff : diff === null ? null : gleich.sort((x, y) => Math.abs(x - diff) - Math.abs(y - diff))[0];
+    return L1 === null ? null : L1 - (L0 - a.zeile);
+}
+const hunksVon = (diff) => [...diff.matchAll(/^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@/gm)].map((m) => [+m[1], m[2] === undefined ? 1 : +m[2], +m[3], m[4] === undefined ? 1 : +m[4]]);
+
+// ───────── DIE DATEIEN DES KOPFS ─────────
+const git = (baum, args) => execFileSync("git", ["-C", baum, ...args], { encoding: "utf8", maxBuffer: 256 << 20, stdio: ["ignore", "pipe", "ignore"] });
+function kopfLeser(baum, kopf) {
+    const cache = new Map();
+    // der Baum des Kopfs: ein Pfad ohne Ordner („feld-brand.js“) gilt, wenn genau EINE Datei des Kopfs so heißt
+    const namen = git(baum, ["ls-tree", "-r", "--full-tree", "--name-only", kopf]).split("\n").filter(Boolean);
+    const da = new Set(namen), basis = new Map();
+    for (const p of namen) { const b = p.split("/").pop(); basis.set(b, basis.has(b) ? null : p); }
+    const pfad = (p0) => (da.has(p0) ? p0 : !p0.includes("/") && basis.get(p0) ? basis.get(p0) : null);
+    const lies = (p0) => {
+        const p = pfad(p0);
+        if (!p) return null;
+        if (!cache.has(p)) cache.set(p, git(baum, ["show", kopf + ":" + p]).split("\n"));
+        return cache.get(p);
+    };
+    lies.pfad = pfad;
+    return lies;
+}
+// der Anker je Angabe (siehe oben); stationen = Ordner der Stationen im Mess-Baum (für git blame)
+function ankerFinder(baum, kopf, lies, stationen) {
+    const logs = new Map(), blames = new Map(), inhalt = new Map(), diffs = new Map();
+    const logVon = (p) => logs.get(p) || logs.set(p, git(baum, ["log", "--first-parent", "--format=%H %ct", kopf, "--", ":(top)" + p]).split("\n").filter(Boolean).map((l) => [l.split(" ")[0], +l.split(" ")[1]])).get(p);
+    const blameVon = (f) => {
+        if (!blames.has(f)) {
+            // der Arbeitsbaum, nicht HEAD: die Zeilen der Angaben sind die der Datei, wie sie liegt (eine umgestellte, noch nicht
+            // eingecheckte Zeile trägt die Zeit von jetzt — ihr Anker ist der Kopf; mit HEAD erbte sie das alte Datum und einen alten Anker)
+            const t = [], roh = git(baum, ["blame", "--line-porcelain", "--", path.join(stationen, f)]);
+            let zeit = 0;
+            for (const l of roh.split("\n")) {
+                if (l.startsWith("committer-time ")) zeit = +l.slice(15);
+                else if (l.startsWith("\t")) t.push(zeit);
+            }
+            blames.set(f, t);
+        }
+        return blames.get(f);
+    };
+    const stand = (sha, p) => {
+        const k = sha + ":" + p;
+        if (!inhalt.has(k)) { let z = null; try { z = git(baum, ["show", k]).split("\n"); } catch (e) {} inhalt.set(k, z); }
+        return inhalt.get(k);
+    };
+    const hunks = (sha, p) => { const k = sha + ":" + p; return diffs.get(k) || diffs.set(k, hunksVon(git(baum, ["diff", "-U0", "--no-color", sha, kopf, "--", ":(top)" + p]))).get(k); };
+    return (a, re) => {
+        const p = lies.pfad(a.datei), T = blameVon(a.stationDatei)[a.stationZeile - 1] || Infinity, log = logVon(p);
+        let i = log.findIndex(([, t]) => t <= T);
+        if (i < 0) i = log.length;
+        const reihe = [...log.slice(i, i + 40), ...log.slice(Math.max(0, i - 10), i).reverse()];
+        for (const [sha] of reihe) {
+            const z = stand(sha, p);
+            if (z && traegt(z, a, re)) return { sha, neu: ankerZeile(z, a, re, hunks(sha, p), lies(a.datei)) };
+        }
+        return null;
+    };
+}
+
+// DER ABDRUCK (punkte.cjs `abdruck`: Kriterium, Befehl, Urteil als Quelltext, Quelle, Befehl der Probe …) ist die Identität einer
+// Station — jede Messung hängt an ihm. Eine Angabe, deren Zeile im Abdruck steht (der Befehl einer Leiter trägt ihren Quelltext ganz),
+// umzustellen hieße die Station neu messen; das Werkzeug stellt nur um, was außerhalb jedes Abdrucks steht (die Wand: liste = Basis),
+// und nennt den Rest „im Abdruck“ mit der Zahl der Stationen.
+function abdruckTexte(stationen) {
+    const t = [];
+    for (const f of fs.readdirSync(stationen).filter((x) => /\.(c?js)$/.test(x))) {
+        let m;
+        try { m = require(path.join(stationen, f)); } catch (e) { continue; }
+        if (!Array.isArray(m)) continue;
+        for (const st of m) {
+            if (!st || typeof st !== "object") continue;
+            const teile = [st.befehl, st.urteil ? String(st.urteil) : "", st.quelle, st.probe && st.probe.befehl, st.pfad];
+            t.push({ id: (st.kriterium || "?") + "#" + (st.staffel || "?"), text: JSON.stringify(teile) + "\n" + teile.flat().filter((x) => typeof x === "string").join("\n") });
+        }
+    }
+    return t;
+}
+function pruefe({ stationen, lies, umstellen = false, fremd = () => false, anker = () => null, abdruck = null }) {
+    const dateien = fs.readdirSync(stationen).filter((f) => /\.(c?js)$/.test(f)).sort();
+    const je = [], alle = [];
+    for (const f of dateien) {
+        const voll = path.join(stationen, f);
+        const src = fs.readFileSync(voll, "utf8");
+        const zeilenAn = []; // Offset → Zeile der Station
+        for (let k = 0, z = 1; k <= src.length; k++) { zeilenAn.push(z); if (src[k] === "\n") z++; }
+        const liste = [];
+        for (const [a, e] of zeichenketten(src)) {
