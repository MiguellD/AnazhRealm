+#!/usr/bin/env node
+"use strict";
+// DIE LESER-ZEILEN DER STATIONEN GEGEN MAIN (Leser 2, 26.11.; die Klasse aus bericht/2611-stationen/gewalt1 §8 „die Leser-Zeilen der
+// Station hinken main nach“: feld-brand.js:440 → heute :449, koerper-fahrt.js:2361 → :2363, voxel-worker.js:1446 → :1501).
+// Eine Station nennt ihren Täter und ihren Leser als `datei:zeile Name` — der Macher folgt der Zeile in main. Steht der Name nicht
+// mehr auf dieser Zeile, schickt die Station ihn an die falsche Stelle. Das Werkzeug liest JEDE solche Angabe in den Zeichenketten der
+// Stationen (nie in Kommentaren: die sind Chronik und nennen Köpfe ihrer Zeit) und prüft sie gegen den Kopf `--gegen` (Vorgabe
+// origin/main):
+//   gleich      die Zeile (oder der Bereich a–b) trägt den Namen
+//   verschoben  die Datei trägt den Namen, die Zeile nicht — die neue Zeile ist die nächste Fundstelle (Abstand steht dabei);
+//               mehrdeutig, wenn eine zweite Fundstelle fast so nah liegt (≤ 1,5 × Abstand und Abstand > 20): dann nennt das Werkzeug
+//               beide und stellt nicht um
+//   fehlt       der Name steht nirgends mehr in der Datei, oder die Datei fehlt in main (umbenannt, entfernt) — beim Namen, nie umgestellt
+// Gezählt wird je Station-Datei n von m (n = verschoben + fehlt, m = alle Angaben mit Code-Namen). Angaben ohne Code-Namen (ein Wort
+// wie „rufen“, eine Klammer „(die Tat)“) stehen als eigene Zahl daneben — geprüft wird nur, was einen Namen trägt, den Code tragen kann
+// (mit _ oder $, innerer Großbuchstabe, KONSTANTE, oder a.b).
+//   node werkzeug/leser-zeilen.cjs [--gegen origin/main] [--stationen stationen] [--liste] [--umstellen] [--json datei]
+//   node werkzeug/leser-zeilen.cjs --selbsttest
+// --umstellen schreibt die verschobenen, eindeutigen Zeilen in die Station-Dateien (nur die Zahl, nur in Zeichenketten).
+const fs = require("fs");
+const path = require("path");
+const { execFileSync } = require("child_process");
+
+// ───────── DER LESER DER QUELLE: Zeichenketten ohne Kommentare (', ", `…${}…`, Regex-Literale überspringen) ─────────
+const KEY_VOR_REGEX = new Set(["return", "typeof", "instanceof", "in", "of", "new", "delete", "void", "throw", "case", "do", "else", "yield", "await"]);
+function zeichenketten(src) {
+    const out = []; // [anfang, ende) des Inhalts
+    let i = 0, vor = null; // vor: Art des letzten Zeichens/Worts außerhalb von Kommentaren
+    const n = src.length;
+    const stapel = []; // offene `${` je Schablone: Klammer-Tiefe
+    let tiefe = 0;
+    const schablone = () => {
+        // i steht hinter dem `; liest bis ` oder ${
+        let a = i;
+        while (i < n) {
+            const c = src[i];
+            if (c === "\\") { i += 2; continue; }
+            if (c === "`") { out.push([a, i]); i++; vor = "str"; return; }
+            if (c === "$" && src[i + 1] === "{") { out.push([a, i]); i += 2; stapel.push(tiefe); tiefe = 0; vor = "punct"; return; }
+            i++;
+        }
+        out.push([a, i]);
+    };
+    while (i < n) {
+        const c = src[i], d = src[i + 1];
+        if (c === "/" && d === "/") { while (i < n && src[i] !== "\n") i++; continue; }
+        if (c === "/" && d === "*") { const e = src.indexOf("*/", i + 2); i = e < 0 ? n : e + 2; continue; }
+        if (c === "'" || c === '"') {
+            const a = ++i;
+            while (i < n && src[i] !== c) { if (src[i] === "\\") i++; i++; }
+            out.push([a, i]); i++; vor = "str"; continue;
+        }
+        if (c === "`") { i++; schablone(); continue; }
+        if (c === "}" && stapel.length && tiefe === 0) { tiefe = stapel.pop(); i++; schablone(); continue; }
+        if (c === "{") { tiefe++; i++; vor = "punct"; continue; }
+        if (c === "}") { tiefe--; i++; vor = "punct"; continue; }
+        if (c === "/") {
+            const regex = vor === null || vor === "punct" || (vor && vor.startsWith("kw:"));
+            if (regex) {
+                i++;
+                let klasse = false;
+                while (i < n) {
+                    const x = src[i];
+                    if (x === "\\") { i += 2; continue; }
+                    if (x === "[") klasse = true;
+                    else if (x === "]") klasse = false;
+                    else if (x === "/" && !klasse) break;
+                    else if (x === "\n") break;
+                    i++;
+                }
+                i++;
+                while (i < n && /[a-z]/i.test(src[i])) i++;
+                vor = "str";
+                continue;
+            }
+            i++; vor = "punct"; continue;
+        }
+        if (/[A-Za-z_$]/.test(c)) {
+            const a = i;
+            while (i < n && /[\w$]/.test(src[i])) i++;
