{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bau-zeile.schema.json",
  "title": "BAU_GESETZ — eine Zeile des Gesetzes: der Bau folgt aus Haushalt und Nutzung",
  "description": "Drei Zeilen-Arten. Ein Bau = bauRezept({nutzung, bauweise, rahmen}, haushalt, seed) -> der Parameter-Vektor hp des HAUS (fachwerk-core.js:158-172) bzw. der Ausstattung (fachwerk-core.js:5974-5978). Jede Kultur ist ein Paar (bauweise, rahmen), jeder Bau-Typ eine nutzung-Zeile, jede Zeit eine rahmen-Zeile. Keine Zeile traegt Code; Regeln sind Daten (Feld, Operator, Wert, Quelle).",
  "oneOf": [
    { "$ref": "#/$defs/nutzung" },
    { "$ref": "#/$defs/bauweise" },
    { "$ref": "#/$defs/rahmen" }
  ],
  "$defs": {
    "quelle": {
      "type": "string",
      "enum": ["physik", "ueberliefert", "geschaetzt"],
      "description": "physik = aus Statik/Bauphysik ableitbar; ueberliefert = Bauforschung/Regelwerk/Befund; geschaetzt = gesetzt, bis eine Quelle sie traegt"
    },
    "einheit": {
      "type": "string",
      "enum": ["m", "m2", "m3", "grad", "anteil", "personen", "stueck", "jahr", "mm_jahr", "kN_m2", "grad_c", "kg_m3", "MPa"]
    },
    "groesse": {
      "type": "object",
      "required": ["wert", "einheit", "quelle"],
      "additionalProperties": false,
      "properties": {
        "wert": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "einheit": { "$ref": "#/$defs/einheit" },
        "quelle": { "$ref": "#/$defs/quelle" },
        "beleg": { "type": "string", "description": "Datei:Zeile im Kern oder Kurzname der Ueberlieferung" }
      }
    },
    "stoff": {
      "type": "string",
      "description": "nur Rollen, die der Kern als Stoff kennt (DEFCOL fachwerk-core.js:1977 + blockholz :182) — eine Zeile erfindet keinen Draw",
      "enum": ["holz", "gefach", "ziegel", "ziegel2", "putz", "dachmod", "stamm", "glas", "metall", "backstein", "lehm", "stein", "stroh", "kupfer", "blockholz", "tuch"]
    },
    "lage": {
      "type": "string",
      "description": "wo ein Raum im Koerper liegt — die Grundriss-Grammatik liest sie (Grundriss-Tafel :499, mkWing :502, annexN :528, hof :1491, balcony :166, turm, Erker = vorkragung)",
      "enum": ["kern", "strasse", "hinten", "oben", "keller", "dach", "fluegel", "anbau", "hof_umlauf", "laube", "erker", "turm", "getrennt", "offen"]
    },
    "regel": {
      "type": "object",
      "description": "rahmen veraendert eine Zahl einer anderen Zeile: ziel = JSON-Pointer in nutzung/bauweise, aus = Groesse des Rahmens, die den Wert treibt",
      "required": ["ziel", "op", "quelle"],
      "additionalProperties": false,
      "properties": {
        "ziel": { "type": "string", "pattern": "^/(nutzung|bauweise)/" },
        "op": { "type": "string", "enum": ["setze", "plus", "mal", "min", "max", "linear"] },
        "wert": { "type": ["number", "string", "boolean"] },
        "aus": { "type": "string", "enum": ["jahr", "alter", "klima.regen", "klima.schnee", "klima.temperatur", "klima.sonne", "ort.stoff", "wohl", "personen", "rang"] },
        "punkte": { "type": "array", "description": "fuer op linear: [[x, y], ...] stueckweise linear, geklemmt", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } },
        "einheit": { "$ref": "#/$defs/einheit" },
        "quelle": { "$ref": "#/$defs/quelle" },
        "beleg": { "type": "string" }
      }
    },
    "haushalt": {
      "type": "object",
      "description": "das Datum des Loses (heute nicht im Plan: leuteVon :9047 liest es nachher aus dem Haus). Eingang des Gesetzes, keine Zeile.",
      "required": ["personen", "wohl"],
      "additionalProperties": false,
      "properties": {
        "personen": { "type": "integer", "minimum": 0, "maximum": 40 },
        "wohl": { "type": "number", "minimum": 0, "maximum": 2, "description": "derselbe Wohlstand wie DORF :3923" },
        "gewerbe": { "type": "string", "description": "id einer nutzung-Zeile, deren Raeume zum Wohnen hinzutreten (Laden, Werkraum, Stall)" },
        "rang": { "type": "number", "minimum": 0, "maximum": 1, "description": "Lage in der Gruendungs-Folge, Kern = 0 (DORF :3914)" }
      }
    },
    "raum": {
      "type": "object",
      "required": ["id", "flaeche", "hoehe", "lage"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "flaeche": {
          "type": "object",
          "required": ["je", "groesse"],
          "additionalProperties": false,
          "properties": {
            "je": { "type": "string", "enum": ["bau", "person", "stueck"], "description": "person: die Flaeche waechst mit dem Haushalt (LEUTE_GESETZ :9046 rueckwaerts gelesen)" },
            "groesse": { "$ref": "#/$defs/groesse" },
            "wohlZuschlag": { "$ref": "#/$defs/groesse", "description": "m2 je Person und Einheit Wohlstand (LEUTE_GESETZ.wohlFlaeche :9046)" }
          }
        },
        "hoehe": { "$ref": "#/$defs/groesse", "description": "lichte Hoehe; das Geschoss wird so hoch wie sein hoechster Raum (egH/ogH :168)" },
        "geschoss": { "type": "string", "enum": ["eg", "og", "dach", "keller", "alle", "frei"] },
        "lage": { "$ref": "#/$defs/lage" },
        "zahl": { "$ref": "#/$defs/groesse" },
        "oeffnung": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "licht": { "$ref": "#/$defs/groesse", "description": "Fensterflaeche / Bodenflaeche" },
            "tor": { "$ref": "#/$defs/groesse", "description": "lichte Breite des groessten Durchgangs (Tenne, Werkstatt, Laden)" },
            "rauch": { "type": "boolean", "description": "Herd/Esse: der Kamin (chimney) folgt" }
          }
        }
      }
    },
    "nutzung": {
      "type": "object",
      "description": "der Bau-Typ: was in ihm geschieht. Ersetzt je Zeile eine Funktion der Tafel STADT_GRAMMATIK.bau (:3811-3829) und die Mass-Literale in DORF (:3940, :3943, :3946, :3957, :3964).",
      "required": ["art", "id", "raeume"],
      "additionalProperties": false,
      "properties": {
        "art": { "const": "nutzung" },
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "fabrik": { "type": "string", "enum": ["haus", "ausstattung"], "default": "haus", "description": "welche Fabrik den Koerper baut: HAUS :158 oder AUS_BAU :7332" },
        "haushalt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "personen": { "type": "string", "enum": ["haushalt", "fest", "keine"] },
            "fest": { "$ref": "#/$defs/groesse" }
          }
        },
        "raeume": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/raum" } },
        "nachbarschaft": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["a", "b", "bezug"],
            "additionalProperties": false,
            "properties": {
              "a": { "type": "string" },
              "b": { "type": "string" },
              "bezug": { "type": "string", "enum": ["neben", "ueber", "um", "vor", "hinter", "getrennt", "unter_einem_dach"] },
              "quelle": { "$ref": "#/$defs/quelle" }
            }
          }
        },
        "geschosse": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "min": { "type": "integer", "minimum": 1 }, "max": { "type": "integer", "maximum": 60 } }
        },
        "grundriss": {
          "type": "array",
          "description": "erlaubte Formen in Rangfolge; der Packer waehlt die erste, deren Flaeche das Los traegt (Grundriss-Tafel :499; Flügel in Raum-Modulen 3,3 m :504)",
          "items": { "type": "string", "enum": ["I", "L", "T", "U", "hof", "kreuz", "rund", "lang"] }
        },
        "zeichen": {
          "type": "array",
          "description": "was der Bau nach aussen zeigt; jedes Zeichen faellt auf einen vorhandenen Schalter oder ist als neu markiert",
          "items": {
            "type": "object",
            "required": ["was"],
            "additionalProperties": false,
            "properties": {
              "was": { "type": "string", "enum": ["turm", "zinnen", "kuppel", "portikus", "arkade", "veranda", "vorkragung", "treppgiebel", "balkon", "esse", "glocke", "schild", "kreuz", "tor", "plane", "auslage"] },
              "wenn": { "type": "string", "description": "Bedingung ueber Haushalt/Rahmen, z. B. 'wohl>=1.1' oder 'band=mittelalter'" },
              "neu": { "type": "boolean", "description": "true: der Kern hat keinen Schalter dafuer" }
            }
          }
        }
      }
    },
    "bauweise": {
      "type": "object",
      "description": "das Tragwerk: wie die Bauweise Last abtraegt. Ersetzt die Bau-Anteile einer KULTUR-Zeile (:1979-2011) und STILMODE (:180-187).",
      "required": ["art", "id", "tragwerk", "stoff", "dach"],
      "additionalProperties": false,
      "properties": {
        "art": { "const": "bauweise" },
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "tragwerk": {
          "type": "string",
          "enum": ["stehendes_geruest", "blockbau", "saeule_gebaelk", "bogen_gewoelbe", "skelett_tragendes_dach", "massivbau", "pfosten_plane"],
          "description": "gebaut heute: stehendes_geruest (Fachwerk-Geruest) und massivbau als glatte Wand ueber ihm (GLATT :197); pfosten_plane = AUS_BAU.marktstand. Die anderen benennt das Schema, der Kern baut sie nicht."
        },
        "stoff": {
          "type": "object",
          "required": ["wand", "dach"],
          "additionalProperties": false,
          "properties": {
            "traeger": { "$ref": "#/$defs/stoff" },
            "wand": { "$ref": "#/$defs/stoff" },
            "fuellung": { "$ref": "#/$defs/stoff" },
            "dach": { "$ref": "#/$defs/stoff" },
            "sockel": { "$ref": "#/$defs/stoff" }
          }
        },
        "spannweiteMax": { "$ref": "#/$defs/groesse", "description": "groesste freie Spannweite des Traegers: begrenzt die Tiefe ohne Mittelstuetze (heute D <= 11 :2031)" },
        "raster": { "$ref": "#/$defs/groesse", "description": "Achsabstand der Staender/Pfeiler (bayMax :171)" },
        "wand": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "art": { "type": "string", "enum": ["fachwerk_gefach", "block_liegend", "bruchstein", "quader", "ziegel_sicht", "lehm", "putz_ueber_massiv", "fuellung_leicht", "keine"] },
            "dicke": { "$ref": "#/$defs/groesse" },
            "verstrebung": { "type": "string", "enum": ["andreas", "k", "mann", "wild", "none"], "description": "brace :163" }
          }
        },
        "geschossHoehe": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "eg": { "$ref": "#/$defs/groesse" }, "og": { "$ref": "#/$defs/groesse" } }
        },
        "dach": {
          "type": "object",
          "required": ["form", "deckung", "grenzNeigung"],
          "additionalProperties": false,
          "properties": {
            "form": { "type": "string", "enum": ["sattel", "walm", "kruppelwalm", "pult", "flach", "zelt", "kuppel", "geschwungen", "terrasse"] },
            "deckung": { "type": "string", "enum": ["biberschwanz", "hohlpfanne", "moench_nonne", "leistenziegel", "schiefer", "schindel", "reet", "grassode", "blech", "lehm_flach", "plane", "glas_metall"] },
            "grenzNeigung": { "$ref": "#/$defs/groesse", "description": "kleinste Neigung, bei der die Deckung dicht bleibt — heute STILMODE.pMin :181-186, geklemmt :198" },
            "neigung": { "$ref": "#/$defs/groesse", "description": "Regelneigung; Rahmen-Regeln (Schnee, Regen) schieben sie, nie unter grenzNeigung" },
            "hip": { "$ref": "#/$defs/groesse" },
            "schwung": { "$ref": "#/$defs/groesse", "description": "roofCurve :5216" },
            "ueberstandTraufe": { "$ref": "#/$defs/groesse", "description": "ovEave :171" },
            "ueberstandOrtgang": { "$ref": "#/$defs/groesse", "description": "ovRake :171" }
          }
        },
        "sockel": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "hoehe": { "$ref": "#/$defs/groesse", "description": "foundH :168" }, "keller": { "type": "boolean" } }
        },
        "oeffnung": {
          "type": "object",
          "description": "Sturz oder Bogen aus Spannweite und Stoff: ueber sturzMax wird gewoelbt oder geteilt",
          "additionalProperties": false,
          "properties": {
            "regel": { "type": "string", "enum": ["sturz", "bogen", "gebaelk", "offen"] },
            "sturzMax": { "$ref": "#/$defs/groesse", "description": "groesste Weite, die der Sturz-Stoff ohne Bogen traegt" },
            "bogen": { "type": "string", "enum": ["none", "rund", "spitz", "hufeisen", "segment"], "description": "bogenTyp :960, :1071" },
            "fensterBreite": { "$ref": "#/$defs/groesse", "description": "heute min(1.05, Feld-0.34) bzw. 1.7 modern :485" },
            "tuer": { "type": "object", "additionalProperties": false, "properties": { "breite": { "$ref": "#/$defs/groesse" }, "hoehe": { "$ref": "#/$defs/groesse" } } }
          }
        },
        "schmuck": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["wo", "womit"],
            "additionalProperties": false,
            "properties": {
              "wo": { "type": "string", "enum": ["balkenkopf", "sturz", "giebel", "portal", "traufe", "first", "gefach", "eckstaender", "saeule"] },
              "womit": { "type": "string" },
              "neu": { "type": "boolean" }
            }
          }
        },
        "farbe": {
          "type": "object",
          "description": "sRGB je Stoff-Rolle (heute KULTUR.col :1980-2011); der Rahmen 'ort.stoff' darf sie verschieben",
          "propertyNames": { "$ref": "#/$defs/stoff" },
          "additionalProperties": { "type": "string", "pattern": "^#[0-9a-f]{6}$" }
        },
        "streuung": {
          "type": "object",
          "description": "die Wuerfel-Spanne je Same (heute kulturParams :2029-2032) — die Gestalt-Vielfalt einer Zeile",
          "additionalProperties": false,
          "properties": { "neigung": { "$ref": "#/$defs/groesse" }, "breite": { "$ref": "#/$defs/groesse" }, "tiefe": { "$ref": "#/$defs/groesse" } }
        }
      }
    },
    "rahmen": {
      "type": "object",
      "description": "Zeit, Ort, Klima: was Jahr, Alter, Klima und Stoff des Orts an den Zahlen der anderen Zeilen aendern. Ersetzt die Zeit-Anteile von EPOCHEN (:3370), REGION_HIST (:3357) und metaParams (:8986-9037).",
      "required": ["art", "id", "zeit", "ort"],
      "additionalProperties": false,
      "properties": {
        "art": { "const": "rahmen" },
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "zeit": {
          "type": "object",
          "required": ["von", "bis"],
          "additionalProperties": false,
          "properties": { "von": { "type": "integer" }, "bis": { "type": "integer" } }
        },
        "ort": {
          "type": "object",
          "required": ["region"],
          "additionalProperties": false,
          "properties": {
            "region": { "type": "string", "enum": ["mitteleuropa", "alpin", "mediterran", "nordisch", "fernost", "antik"] },
            "klima": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "regen": { "$ref": "#/$defs/groesse" },
                "schnee": { "$ref": "#/$defs/groesse" },
                "temperatur": { "$ref": "#/$defs/groesse" },
                "sonne": { "$ref": "#/$defs/groesse" }
              }
            },
            "stoff": {
              "type": "array",
              "description": "was der Ort hergibt (Gelaende-Kern, Wald) — heute nicht im Plan (exportSettlement :9243-9250)",
              "items": { "$ref": "#/$defs/stoff" }
            }
          }
        },
        "bauweisen": { "type": "array", "description": "welche bauweise-Zeilen in diesem Rahmen stehen (heute die Pools je Jahr in REGION_HIST)", "items": { "type": "string" } },
        "nutzungen": { "type": "array", "description": "welche Bau-Typen der Rahmen kennt (heute STADT_GRAMMATIK.zeit :3786)", "items": { "type": "string" } },
        "regeln": { "type": "array", "items": { "$ref": "#/$defs/regel" } },
        "alter": {
          "type": "object",
          "description": "was das Alter (Jahr des Orts minus Baujahr) in denselben Bau schreibt",
          "additionalProperties": false,
          "properties": {
            "patina": { "$ref": "#/$defs/groesse", "description": "verwitterung :5977 je Jahr" },
            "setzung": { "$ref": "#/$defs/groesse" },
            "umbau": { "$ref": "#/$defs/groesse", "description": "Wahrscheinlichkeit je Jahrhundert fuer einen Anbau (annexN)" }
          }
        }
      }
    }
  }
}
