 meisterkarte-quelle/punkte/stationen/g5.js | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/meisterkarte-quelle/punkte/stationen/g5.js b/meisterkarte-quelle/punkte/stationen/g5.js
index 6ed38378..0315d604 100644
