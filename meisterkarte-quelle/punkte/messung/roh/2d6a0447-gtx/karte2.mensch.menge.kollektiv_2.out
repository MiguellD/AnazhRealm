                await K.schritt(n, async () => {
                    const z = await zensus();
                    K.nicht(n, { n: z.alle, fehlt: fehlt + ": die Welt trägt " + z.alle + " Bewohner in " + z.siedlungen + " Siedlungen (die Stadt " + z.stadt + ")" });
                });
