        if (!da) throw new Error("kein Bild S" + n + ": " + kurz(a && (a.fehler || a.abnahme)));
        return { datei: da, abnahme: kurz(a && (a.abnahme || a.fehler)) };
    };
    K.ende = () => j;
    return K;
},
SPEC: {"leiter":"mensch.menge.seuche","sprossen":{"1":{"umfang":{"soll":1,"wort":"Person krank"},"masse":[{"key":"tag","wort":"Anteil der Viertelstunden, in denen der Krank-Tag vom gesunden Tag abweicht","soll":0,"richtung":">","herkunft":"„Krank-Tag weicht ab“: der Tag des Kranken gegen seinen gesunden Tag, strikt über 0"},{"key":"haltung","wort":"Anteil Kranker, deren Haltung im Bild von der des Gesunden im selben Akt abweicht","soll":1,"richtung":"≥","herkunft":"„Bildpaar gesund/krank“ mit der Tiefe „Haltung, Husten“: das Paar trennt sich am Leib — jeder Kranke, den das Bild zeigt"}]},"2":{"umfang":{"soll":100,"wort":"Bewohner im Ausbruch"},"masse":[{"key":"sir","wort":"Kurve in der Form S-I-R (1 = ja)","soll":1,"richtung":"≥"},{"key":"r0","wort":"R0 im Band des Erregers (1 = ja)","soll":1,"richtung":"≥"}]},"3":{"umfang":{"soll":10000,"wort":"Bewohner einer Stadt"},"masse":[{"key":"senkung","wort":"Senkung der Spitze bei geschlossenem Markt","soll":0.3,"richtung":"≥"}]},"4":{"umfang":{"soll":1000000,"wort":"Bewohner einer Region"},"masse":[{"key":"r","wort":"Korrelation Ankunft und Netzabstand","soll":0.7,"richtung":"≥"}]},"5":{"umfang":{"soll":100000000,"wort":"Menschen über Epochen"},"masse":[{"key":"erreger","wort":"Anteil Erreger im historischen Band","soll":0.8,"richtung":"≥"},{"key":"lebenserwartung","wort":"Zuwachs der Lebenserwartung 1800 bis 2000 in J","soll":30,"richtung":"≥"}]},"6":{"umfang":{"soll":10000000000,"wort":"Menschen eines Planeten"},"masse":[{"key":"wellenzahl","wort":"Wellenzahl im Band realer Pandemien (1 = ja)","soll":1,"richtung":"≥"},{"key":"abstand","wort":"Wellenabstand im Band realer Pandemien (1 = ja)","soll":1,"richtung":"≥"},{"key":"ketten","wort":"Anteil verfolgbarer Infektionsketten","soll":1,"richtung":"≥"}]}}},
STADT: (r, T) => {
    const s = r.state, A = r.constructor, pm = s.playerMesh.position;
    const listen = [...(r._bewohnerSiedlungen || new Map()).values()].filter((S) => Array.isArray(S.liste) && S.liste.length);
    const S = listen.slice().sort((a, b) => b.liste.length - a.liste.length)[0] || null;
    const L = S ? S.liste : [];
    const tag0 = s.dayLengthMinutes;
    s.dayLengthMinutes = A.DAY_LENGTH_DEFAULT_MINUTES;
    const ab = (a, b) => Math.hypot(a.x - b.x, a.z - b.z);
    const leute = (dt) => {
        r._bewohnerWerkTakt(Infinity);
        r._tickBewohner(dt);
    };
    const ankunft = () => {
        let n = 0;
        for (let m = Infinity, still = 0, k; still < 5 && n < 3000 && (k = (leute(0), r._weltOffen().leute)); m = k) {
            still = k < m ? 0 : still + 1;
            n++;
        }
        return n;
    };
    const stunde = () => (((s.timeOfDay % 1) + 1) % 1) * 24;
    // gewiss ein Sprung: steht die Uhr näher als sprungH an h, erst über die Gegen-Stunde (wie `uhrAuf` der Kreatur-Proben)
    const uhrAuf = (h) => {
        const d = Math.abs(stunde() - h);
        if (Math.min(d, 24 - d) < 0.3) {
            r.setTimeOfDay(((h + 12) % 24) / 24, "regler");
            leute(0);
        }
        r.setTimeOfDay((h % 24) / 24, "regler");
        return ankunft();
    };
    let uhr = performance.now();
    const takt = async (n) => {
        for (let k = 0; k < n; k++) {
            uhr += A.TAKT_DECKEL_S * 1000;
            r._gameLoopTick(uhr);
            await window.sleep();
        }
    };
    const draussen = (R) => L.filter((b) => b.leib && !b.drinnen && (!R || ab(b.leib.position, pm) < R));
    // die Pose eines Augen-Bilds: 7 m vor der dichtesten Gruppe (4 m) binnen 20 m am Spieler, Augenhöhe 1,7 m, frei von Grundrissen
    const pose = () => {
        const pts = draussen(20).map((b) => b.leib.position);
        let best = null, bn = 0;
        for (const p of pts) {
            let n = 0;
            for (const q of pts) if (ab(p, q) < 4) n++;
            if (n > bn) (bn = n), (best = p);
        }
        if (!best) return null;
        for (let w = 0; w < 8; w++) {
            const a = Math.atan2(pm.z - best.z, pm.x - best.x) + (w * Math.PI) / 4;
            const cx = best.x + Math.cos(a) * 7, cz = best.z + Math.sin(a) * 7;
            const g = r._imGrundriss(cx, cz, 0.5);
            if (g === "haus" || g === "bau") continue;
            const q2 = (v) => +v.toFixed(2);
            return {
                pose: { px: q2(cx), py: q2(r.getTerrainHeightAt(cx, cz) + 1.7), pz: q2(cz), lx: q2(best.x), ly: q2(r.getTerrainHeightAt(best.x, best.z) + 1.2), lz: q2(best.z) },
                dicht: bn,
                dichteQm: +(bn / (Math.PI * 16)).toFixed(3),
                imKreis: pts.length,
            };
        }
        return null;
    };
