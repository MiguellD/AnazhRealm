    K.nicht = (n, o) => setze(n, { art: "nicht", n: o.n, fehlt: kurz(o.fehlt) });
    K.leser = (n, o) => setze(n, { art: "leser", fehlt: kurz(o.fehlt), wo: kurz(o.wo), ...(o.n != null ? { n: o.n } : {}) });
    K.auge = (n, o) => setze(n, { art: "auge", bild: o.bild, pose: kurz(o.pose), vorbild: kurz(o.vorbild || (SPEC.sprossen[n] && SPEC.sprossen[n].auge && SPEC.sprossen[n].auge.vorbild)), ...(o.mass ? { mass: kurz(o.mass) } : {}) });
    // DAS BILD EINER AUGEN-SPROSSE: der Ausgabe-Pfad der Spiel-Kamera (werkbank /bild) an fester Pose { px, py, pz, lx, ly, lz },
    // abgelegt neben der Ausgabe der Probe (<AUS>-S<n>.png; die Abnahme der Werkbank legt ein ROT-Bild als -rot.png daneben)
    K.bild = async (n, pose, mehr) => {
        const datei = String(H.AUS).replace(/\.json$/i, "") + "-S" + n + ".png";
        let a = null;
        try {
            a = await H.wb("/bild", Object.assign({ datei, w: 1280, h: 720 }, pose, mehr || {}), 90000);
        } catch (e) {
            a = { fehler: String((e && e.message) || e) };
        }
        const da = [a && a.datei, datei, datei.replace(/\.png$/i, "-rot.png")].find((f) => f && H.fs.existsSync(f));
        if (!da) throw new Error("kein Bild S" + n + ": " + kurz(a && (a.fehler || a.abnahme)));
        return { datei: da, abnahme: kurz(a && (a.abnahme || a.fehler)) };
    };
    K.ende = () => j;
    return K;
},
SPEC: {"leiter":"mensch.wirtschaft.technik","sprossen":{"1":{"umfang":{"soll":10,"wort":"Techniken mit Voraussetzung"},"masse":[{"key":"ohneVor","wort":"Techniken ohne Voraussetzung im Bild (20 Saaten)","soll":0,"richtung":"≤"},{"key":"staende","wort":"verschiedene Stände (20 Saaten)","soll":2,"richtung":"≥","herkunft":"„Technik wächst aus Voraussetzungen“: hängt der Stand an Stoff und Ort, tragen 20 Saaten nicht alle denselben — ein Stand für jede Saat ist eine Liste"}]},"2":{"umfang":{"soll":100,"wort":"Techniken in ≥ 5 Pfaden"},"masse":[{"key":"pfade","wort":"plausible Pfadfolgen (50 Saaten)","soll":5,"richtung":"≥"},{"key":"streuung","wort":"Streuung der Erfindungsjahre","soll":0.1,"richtung":"≥"}]},"3":{"umfang":{"soll":1000,"wort":"Techniken als sichtbare Dinge"},"masse":[{"key":"passt","wort":"Artefakte passen zum Pfad","soll":0.8,"richtung":"≥"},{"key":"H","wort":"Kettentiefe H","soll":10,"richtung":"≥"}]},"4":{"umfang":{"soll":10000,"wort":"Techniken bis Dampf, Elektrik, Chemie"},"masse":[{"key":"r","wort":"Ausbreitung ↔ Handelsdichte (r)","soll":0.6,"richtung":"≥"},{"key":"front","wort":"Front km/Jahr","von":0.3,"bis":3},{"key":"mehrfach","wort":"mehrfach erfunden","soll":0.6,"richtung":"≥"}]},"5":{"umfang":{"soll":10,"wort":"Pfade zum Halbleiter"},"masse":[{"key":"kette","wort":"Pfade mit lückenloser Kette","soll":10,"richtung":"≥"}]},"6":{"auge":{"pose":"20 m südlich der Mitte der Stadt, Ego 1,7 m, je Epoche","vorbild":"Bildreihe eines realen Orts über 10 Epochen (Stadtansichten): Ort wiedererkannt ≥ 80 %, 0 Werkzeuge ohne Vorgänger"}},"7":{"auge":{"pose":"Ego 1,7 m je fremder Welt","vorbild":"Panel: „folgt aus Stoffen“ ≥ 80 % UND „nicht unsere Geschichte“ ≥ 80 % an ≥ 10 Pfaden"}}}},
STADT: async (r, T, arg) => {
    const s = r.state;
    const pm = s.playerMesh.position;
    const offen = () => {
        const o = typeof r._weltOffen === "function" ? r._weltOffen() : {};
        return !o.leute && !o.leiber;
    };
    const alle = () => [...(r._bewohnerSiedlungen || new Map()).values()].filter((S) => S && S.plan);
    await window.__gebautNach("die Stadt am Messort (Zensus wirtschaft)", {
        fertig: () => alle().some((S) => Array.isArray(S.liste) && S.liste.length > 0) && offen(),
    });
    const SL = alle().sort((a, b) => Math.hypot(a.ox - pm.x, a.oz - pm.z) - Math.hypot(b.ox - pm.x, b.oz - pm.z));
    if (!SL.length) throw new Error("keine Siedlung mit Plan am Messort");
    const plus = (o, k, n) => (o[k] = (o[k] || 0) + (n == null ? 1 : n));
    const imPlan = (S, x, z, saum) => {
        const w = S.plan.welt;
        if (!w) return Math.hypot(x - S.ox, z - S.oz) < 300;
        const lx = x - S.ox, lz = z - S.oz;
        return lx >= w.x0 - saum && lx <= w.x1 + saum && lz >= w.z0 - saum && lz <= w.z1 + saum;
    };
    const Z = {
        siedlungen: SL.length, bewohner: 0, mitWerk: 0, berufe: {}, rollen: {}, slotRollen: {}, haeuser: 0, haendler: 0, staende: 0,
        maerkte: 0, wagen: 0, fahrer: 0, fahrten: 0, fernWagen: 0, laternen: 0, lichtOrte: 0, jahre: [], schmieden: 0, schmiede: null,
        muehlen: 0, inventar: {}, nah: { ox: SL[0].ox, oz: SL[0].oz, name: SL[0].plan.name || null },
    };
    for (const S of SL) {
        const P = S.plan;
        if (Number.isFinite(P.jahr)) Z.jahre.push(P.jahr);
        for (const sl of P.slots || []) {
            Z.haeuser++;
            const ro = typeof sl.rolle === "string" ? sl.rolle : "wohnhaus";
            plus(Z.slotRollen, ro);
            if (/schmied/i.test(ro)) {
                Z.schmieden++;
                if (!Z.schmiede) Z.schmiede = { x: S.ox + sl.x, z: S.oz + sl.z, phi: sl.phi || 0 };
            }
        }
        for (const b of Array.isArray(S.liste) ? S.liste : []) {
            Z.bewohner++;
            plus(Z.berufe, String(b.beruf));
            plus(Z.rollen, String(b.rolle));
            if (b.orte && b.orte.werk) Z.mitWerk++;
            if (/haendler/i.test(String(b.rolle) + " " + String(b.beruf))) Z.haendler++;
        }
        const st = (P.staende || []).length;
        Z.staende += st;
        if (st > 0) Z.maerkte++;
        const lat = (P.laternen || []).length;
        Z.laternen += lat;
        if (lat > 0) Z.lichtOrte++;
        for (const W of (S.verkehr && S.verkehr.wagen) || []) {
            Z.wagen++;
            if (Array.isArray(W.fahrer) && W.fahrer.length) Z.fahrer++;
            if (Number.isFinite(W.ziele)) Z.fahrten += W.ziele;
            const p = W.entry && W.entry.position;
            if (p && !imPlan(S, p.x, p.z, 5)) Z.fernWagen++;
        }
    }
    for (const e of s.architectures || []) {
        if (!e || e._verkehrWagen || !e.mesh || !e.mesh.userData) continue;
        const idle = e.mesh.userData._idleMotion;
        if (!Array.isArray(idle) || !idle.some((x) => x && (x.role === "rad" || x.role === "segel"))) continue;
        const p = e.mesh.position;
        if (SL.some((S) => imPlan(S, p.x, p.z, 30))) Z.muehlen++;
    }
    for (const x of (s.player && s.player.inventory) || []) if (x && x.kind === "material") plus(Z.inventar, String(x.material), x.count || 0);
    return Z;
},
TECHNIK: async (r, T, arg) => {
    const FC = globalThis.__fachwerkCore;
    if (!FC || typeof FC.technikImBild !== "function" || !FC.TECHNIK) return { fehlt: "der Kern trägt kein Technik-Gesetz (fachwerk technikImBild fehlt) — kein Stand im Plan" };
    const G = FC.TECHNIK.graph, mitVor = Object.keys(G).filter((k) => G[k].vor.length);
    const o = { mitVor: mitVor.length, ohneVor: 0, ohne: {}, imBild: {}, staende: 0, saaten: 0, welt: null };
    const st = new Set();
    for (let seed = 1; seed <= arg.saaten; seed++) {
        const D = FC.DORF({ seed, nH: arg.nH, epoche: FC.siedlungsEpoche(seed) });
        if (!D.technik) return { fehlt: "der Plan der Saat " + seed + " trägt keinen Technik-Stand" };
        const B = FC.technikImBild({ technik: D.technik, slots: D.houses });
        o.saaten++;
        o.ohneVor += B.ohneVor;
        for (const k in B.ohne) o.ohne[k] = (o.ohne[k] || 0) + B.ohne[k];
        for (const k in B.imBild) o.imBild[k] = (o.imBild[k] || 0) + B.imBild[k];
        st.add(D.technik.stand.join(","));
    }
    o.staende = st.size;
    // die Stadt am Messort, wie die Welt sie gebaut hat
    let S = null, d = Infinity;
    for (const q of (r._bewohnerSiedlungen || new Map()).values()) {
        const e = Math.hypot(q.ox - arg.ox, q.oz - arg.oz);
        if (q && q.plan && e < d) [S, d] = [q, e];
    }
    if (S && S.plan.technik) {
        const B = FC.technikImBild(S.plan);
        o.welt = { ohneVor: B.ohneVor, ohne: B.ohne, stand: S.plan.technik.stand.length, ohneTechnik: S.plan.technik.fehlt, epoche: S.plan.technik.epoche };
        o.ohneVor += B.ohneVor;
        for (const k in B.ohne) o.ohne[k] = (o.ohne[k] || 0) + B.ohne[k];
    } else o.welt = { fehlt: S ? "der Plan der Stadt trägt keinen Technik-Stand" : "keine Siedlung am Messort" };
    return o;
}
};
H.fahre(async (H) => {
