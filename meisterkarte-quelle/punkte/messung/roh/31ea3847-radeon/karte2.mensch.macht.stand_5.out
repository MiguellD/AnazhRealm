H.seite = {
K: function k2Werkzeug(H, SPEC) {
    const K = { H, SPEC, sicht: "ego" };
    const j = (K.j = H.teil = { leiter: SPEC.leiter, adapter: null, sprossen: {} });
    // DER ADAPTER DER SITZUNG: die Welt nennt ihn in ihrem Log (PUNKTE_SITZUNG_LOG) — Zeile der Probe und Feld des JSON
    K.adapter = () => {
        let z = null;
        try {
            const t = H.fs.readFileSync(String(process.env.PUNKTE_SITZUNG_LOG || ""), "utf8");
            z = (/\[linse-gpu\][^\r\n]*/.exec(t) || [null])[0];
        } catch (_e) {}
        j.adapter = z || "[linse-gpu] ungenannt";
        console.log(j.adapter);
        return j.adapter;
    };
    // ein Funktionsrumpf in der Seite der Welt (r = Welt, T = THREE)
    K.welt = (code, ms) => H.evalWelt(code, ms || 30000);
    // DER MESSORT (spec/profiband/haushalt.json `messorte`): der Aufruf im Text heißt `K.messort("<ort>")` — so liest die Sitzung den Ort
    // und stellt VOR dem Deckel um (punkte.cjs probeOrt); die Sicht vorher über K.sicht ("ego" | "third")
    K.messort = async (ort) => {
        const a = await H.wb("/umstellen", { ort, sicht: K.sicht }, 120000);
        if (!a || a.fehler) throw H.messort(new Error("/umstellen " + ort + ": " + ((a && a.fehler) || "ohne Antwort")), "/umstellen");
        H.zeile("am Messort " + ort + " (" + K.sicht + ")");
        return a;
    };
    K.warte = (ms) => H.schlaf(ms);
    // JE SPROSSE EIN SCHRITT: ein Wurf ist keine Messung (die Sprosse bleibt ohne Ergebnis → UNGEMESSEN beim Namen), ein Wurf des
    // Messorts endet die Probe (die Marke MESSORT); an der Frist bleibt die Sprosse ungemessen, nie geraten
    K.schritt = async (n, f) => {
        if (H.rest() < 2) {
            H.zeile("S" + n + " an der Frist ausgelassen (" + H.sek() + " s)");
            return null;
        }
        try {
            return await f();
        } catch (e) {
            if (e && e.messort) throw e;
            const t = String((e && e.message) || e).split("\n")[0].slice(0, 300);
            H.zeile("S" + n + " warf: " + t);
            j.sprossen[n] = { art: "fehler", text: t };
            return null;
        }
    };
    const kurz = (t) => String(t == null ? "" : t).slice(0, 300);
    // DER STAND NACH JEDER SPROSSE (punkte.cjs keinUrteil (e)): die Ausgabe trägt jedes Ergebnis ganz, ehe die nächste Sprosse misst —
    // reißt danach die Frist oder tötet die Leine die Probe, urteilt die Sprosse aus ihr (daneben geschrieben, dann umbenannt)
    const setze = (n, e) => {
        j.sprossen[n] = e;
        try {
            H.fs.writeFileSync(H.AUS + ".stand", JSON.stringify(j));
            H.fs.renameSync(H.AUS + ".stand", H.AUS);
        } catch (x) {
            H.zeile("Stand: " + String((x && x.message) || x).split("\n")[0]);
        }
        return e;
    };
    K.zahl = (n, o) => setze(n, { art: "zahl", n: o.n, werte: o.werte || {}, ...(o.beleg ? { beleg: kurz(o.beleg) } : {}), ...(o.taeter ? { taeter: kurz(o.taeter) } : {}) });
    K.nicht = (n, o) => setze(n, { art: "nicht", n: o.n, fehlt: kurz(o.fehlt) });
    K.leser = (n, o) => setze(n, { art: "leser", fehlt: kurz(o.fehlt), wo: kurz(o.wo), ...(o.n != null ? { n: o.n } : {}) });
    K.auge = (n, o) => setze(n, { art: "auge", bild: o.bild, pose: kurz(o.pose), vorbild: kurz(o.vorbild || (SPEC.sprossen[n] && SPEC.sprossen[n].auge && SPEC.sprossen[n].auge.vorbild)), ...(o.mass ? { mass: kurz(o.mass) } : {}) });
    // DAS BILD EINER AUGEN-SPROSSE: der Ausgabe-Pfad der Spiel-Kamera (werkbank /bild) an fester Pose { px, py, pz, lx, ly, lz },
    // abgelegt neben der Ausgabe der Probe (<AUS>-S<n>.png; die Abnahme der Werkbank legt ein ROT-Bild als -rot.png daneben)
    K.bild = async (n, pose, mehr) => {
        const datei = String(H.AUS).replace(/\.json$/i, "") + "-S" + n + ".png";
        let a = null;
        try {
            a = await H.wb("/bild", Object.assign({ datei, w: 1280, h: 720 }, pose, mehr || {}), 90000);
        } catch (e) {
            a = { fehler: String((e && e.message) || e) };
        }
        const da = [a && a.datei, datei, datei.replace(/\.png$/i, "-rot.png")].find((f) => f && H.fs.existsSync(f));
        if (!da) throw new Error("kein Bild S" + n + ": " + kurz(a && (a.fehler || a.abnahme)));
        return { datei: da, abnahme: kurz(a && (a.abnahme || a.fehler)) };
    };
    K.ende = () => j;
    return K;
},
SPEC: {"leiter":"mensch.macht.stand","sprossen":{"1":{"auge":{"pose":"stadt-voll: das reichste und das ärmste Wohnhaus nebeneinander, die Kamera 30 m quer über ihrer Mitte, 18 m hoch","vorbild":"archäologische Hausflächen einer mittelalterlichen Stadt (Kohler et al. 2017, Gini der Hausflächen) und ein reales Paar Patrizierhaus/Kleinhaus (Lübeck, Mengstraße)"}},"2":{"auge":{"pose":"stadt-voll: Nah-Bild des nächsten Bewohners draußen, 3,5 m vor ihm in Augenhöhe","vorbild":"ständische Kleidung und Viertel einer spätmittelalterlichen Stadt (Kleiderordnungen, Nürnberg um 1500)"}},"4":{"umfang":{"soll":1000000,"wort":"Bewohner mit Stand und Lebenslauf"},"masse":[{"key":"lebensdauer","wort":"Lebensdauer oben/unten gegen die Quelle (rel. Fehler, ± 20 %)","soll":0.2,"richtung":"≤"}]},"5":{"umfang":{"soll":1000000000,"wort":"Bewohner über alle Epochen"},"masse":[{"key":"umsturz","wort":"Umstürze folgen Gini-Spitzen","soll":0.7,"richtung":"≥"}]},"6":{"auge":{"pose":"stadt-voll: der nächste Bewohner einer fremden Art, 3,5 m vor ihm","vorbild":"Rangordnungen sozialer Arten (Ameisen-Kasten, Primaten-Hierarchien) aus dem Bild"}}}},
STAND: async (r, T, arg) => {
                const pm = r.state.playerMesh.position;
                const plaene = [...(r._ortPlaene || new Map()).values()].filter((p) => p && p.ort && Array.isArray(p.slots) && Math.hypot(p.ort.x - pm.x, p.ort.z - pm.z) < 1500);
                if (!plaene.length) return { fehler: "kein Ortsplan binnen 1,5 km vom Platz" };
                const WOHN = { wohnhaus: 1, patrizierhaus: 1, wohnturm: 1, pfarrhaus: 1, kontor: 1 };
                const haus = [];
                const vw = new Map();
                for (const p of plaene)
                    for (const s of p.slots) {
                        if (!WOHN[s.rolle]) continue;
                        const ov = s.ov || {};
                        const fl = (ov.W || 2 * ((s.obb && s.obb.ex) || 3)) * (ov.D || 2 * ((s.obb && s.obb.ez) || 3)) * (ov.storeys || 1);
                        haus.push({ x: p.ort.x + s.x, z: p.ort.z + s.z, fl, rolle: s.rolle, wohl: Number.isFinite(ov.wohl) ? ov.wohl : 1, viertel: s.viertel || "?" });
                        const v = vw.get(s.viertel || "?") || [];
                        v.push(Number.isFinite(ov.wohl) ? ov.wohl : 1);
                        vw.set(s.viertel || "?", v);
                    }
                if (haus.length < 2) return { fehler: "weniger als zwei Wohnbauten in den Plänen" };
                const f = haus.map((h) => h.fl).sort((a, b) => a - b);
                const n = f.length;
                const sum = f.reduce((s, v) => s + v, 0);
                let g = 0;
                for (let i = 0; i < n; i++) g += (2 * (i + 1) - n - 1) * f[i];
                const gini = g / (n * sum);
                // das Bildpaar: das nächste Paar aus dem reichsten und dem ärmsten Zehntel
                const [lo, hi] = [f[Math.floor(n * 0.1)], f[Math.ceil(n * 0.9) - 1]];
                const arm = haus.filter((h) => h.fl <= lo), reich = haus.filter((h) => h.fl >= hi);
                let paar = null;
                for (const a of arm) for (const b of reich) { const d = Math.hypot(a.x - b.x, a.z - b.z); if (d > 4 && (!paar || d < paar.d)) paar = { a, b, d }; }
                if (!paar) return { fehler: "kein Paar arm/reich" };
                const [mx, mz] = [(paar.a.x + paar.b.x) / 2, (paar.a.z + paar.b.z) / 2];
                const [ux, uz] = [(paar.b.x - paar.a.x) / paar.d, (paar.b.z - paar.a.z) / paar.d];
                const my = r.getTerrainHeightAt(mx, mz);
                const posePaar = { px: +(mx - uz * 30).toFixed(2), py: +(my + 18).toFixed(2), pz: +(mz + ux * 30).toFixed(2), lx: +mx.toFixed(2), ly: +(my + 3).toFixed(2), lz: +mz.toFixed(2) };
                // die Viertel: der Anteil der Streuung des Wohlstands zwischen ihnen (η²)
                const alle = [...vw.values()].flat();
                const mAll = alle.reduce((s, v) => s + v, 0) / alle.length;
                let [zw, tot] = [0, 0];
                for (const v of vw.values()) { const m = v.reduce((s, x) => s + x, 0) / v.length; zw += v.length * (m - mAll) ** 2; }
                for (const v of alle) tot += (v - mAll) ** 2;
                // die Bewohner der Welt und der nächste draußen (das Nah-Bild)
                let [bewohner, fremd] = [0, 0];
                let nah = null;
                const arten = new Set();
                for (const S of (r._bewohnerSiedlungen || new Map()).values())
                    for (const b of S.liste || []) {
                        bewohner++;
                        if (b.art && b.art !== "mensch") arten.add(b.art);
                        if (!b.leib || b.drinnen) continue;
                        const d = Math.hypot(b.leib.position.x - pm.x, b.leib.position.z - pm.z);
                        if (d > 1.5 && (!nah || d < nah.d)) nah = { b, d };
                    }
                fremd = arten.size;
                if (!nah) return { fehler: "kein Bewohner draußen am Platz" };
