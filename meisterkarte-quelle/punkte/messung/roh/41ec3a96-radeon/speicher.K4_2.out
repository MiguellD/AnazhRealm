        const v = new window.THREE.Vector3(x, r._voxelSurfaceY(x, z) + 0.3, z).project(st.camera);
        return l.some((e) => Math.hypot((e.position || e).x - x, (e.position || e).z - z) < 0.5) && Math.max(Math.abs(v.x), Math.abs(v.y), v.z) < 1;
