marke[k] = flecken.length;
st.push(k);
}
}
}
flecken.push(n);
}
const gross = flecken.filter((n) => n >= 20);
return {
glieder: g.length,
sichtbar: im.filter((n) => n >= 20).length,
je: im,
flecken: gross.length,
kruemel: flecken.length - gross.length,
