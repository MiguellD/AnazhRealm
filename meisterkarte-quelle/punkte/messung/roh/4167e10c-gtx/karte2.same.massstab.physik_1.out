    const nullV = () => (typeof s.playerVel.setValue === "function" ? s.playerVel.setValue(0, 0, 0) : null, (s._fieldVy = 0));
    let t = Number.isFinite(s._fixedSimTime) ? s._fixedSimTime : 0, n = 0, land = null, tief = Infinity;
