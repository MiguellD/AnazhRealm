    return { h: 10, grund: +grund.toFixed(3), dt, schritte: n, tLand: land, tief: +tief.toFixed(3), bahn, gSpiel: Math.abs(s.gravity), gGesetz: g };
},
bremse: async function physikBremse(r) {
