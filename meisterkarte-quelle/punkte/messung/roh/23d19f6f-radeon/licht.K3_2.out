        }
        const kind = cp.spawn(process.execPath, ["scripts/werkbank.cjs", ...L.args, "--port", String(S), "--datei", tor.aus], {
            env: { ...process.env, WERKBANK_PORT: String(S) },
            stdio: ["ignore", "pipe", "pipe"],
        });
