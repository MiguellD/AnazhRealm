        if (!da) throw new Error("kein Bild S" + n + ": " + kurz(a && (a.fehler || a.abnahme)));
        return { datei: da, abnahme: kurz(a && (a.abnahme || a.fehler)) };
    };
    K.ende = () => j;
    return K;
},
SPEC: {"leiter":"mensch.geist.absicht","sprossen":{"1":{"umfang":{"soll":100,"wort":"Bewohner"},"masse":[{"key":"zug","wort":"Anteil ihrem Zug zugeordnet","soll":0.6,"richtung":"≥"}]},"2":{"umfang":{"soll":1000,"wort":"Bewohner"},"masse":[{"key":"fortschritt","wort":"Anteil sichtbarer Fortschritt nach 1 Spieljahr","soll":0.5,"richtung":"≥"}]},"3":{"umfang":{"soll":10000,"wort":"Bewohner"},"masse":[{"key":"ziele","wort":"Anteil erklärter Ziele in der Welt","soll":0.3,"richtung":"≥"},{"key":"rueckfuehrbar","wort":"Anteil Ziele auf eine Person rückführbar","soll":1,"richtung":"≥"}]},"4":{"auge":{"pose":"stadt-voll, je Saat die Geschichte eines Bewohners","vorbild":"Geschichten „erzählenswert und folgerichtig“ (Panel ≥ 0,5)"}},"5":{"umfang":{"soll":1000000000,"wort":"Menschen über Epochen"},"masse":[{"key":"anachron","wort":"Anteil anachronistischer Ziele","soll":0.01,"richtung":"≤"},{"key":"verteilung","wort":"Verteilung der Ziele im historischen Band (1 = ja)","soll":1,"richtung":"≥"}]},"6":{"umfang":{"soll":100,"wort":"Welten fremder Gesellschaften"},"masse":[{"key":"rang","wort":"Rang des vorhergesagten Lebensentwurfs","soll":0.7,"richtung":"≥"}]}}},
STADT: (r, T) => {
    const s = r.state, A = r.constructor, pm = s.playerMesh.position;
    const listen = [...(r._bewohnerSiedlungen || new Map()).values()].filter((S) => Array.isArray(S.liste) && S.liste.length);
    const S = listen.slice().sort((a, b) => b.liste.length - a.liste.length)[0] || null;
    const L = S ? S.liste : [];
    const tag0 = s.dayLengthMinutes;
    s.dayLengthMinutes = A.DAY_LENGTH_DEFAULT_MINUTES;
    const ab = (a, b) => Math.hypot(a.x - b.x, a.z - b.z);
    const leute = (dt) => {
        r._bewohnerWerkTakt(Infinity);
        r._tickBewohner(dt);
    };
    const ankunft = () => {
        let n = 0;
        for (let m = Infinity, still = 0, k; still < 5 && n < 3000 && (k = (leute(0), r._weltOffen().leute)); m = k) {
            still = k < m ? 0 : still + 1;
            n++;
        }
        return n;
    };
    const stunde = () => (((s.timeOfDay % 1) + 1) % 1) * 24;
    // gewiss ein Sprung: steht die Uhr näher als sprungH an h, erst über die Gegen-Stunde (wie `uhrAuf` der Kreatur-Proben)
    const uhrAuf = (h) => {
        const d = Math.abs(stunde() - h);
        if (Math.min(d, 24 - d) < 0.3) {
            r.setTimeOfDay(((h + 12) % 24) / 24, "regler");
            leute(0);
        }
        r.setTimeOfDay((h % 24) / 24, "regler");
        return ankunft();
    };
    let uhr = performance.now();
    const takt = async (n) => {
        for (let k = 0; k < n; k++) {
            uhr += A.TAKT_DECKEL_S * 1000;
            r._gameLoopTick(uhr);
            await window.sleep();
        }
    };
    const draussen = (R) => L.filter((b) => b.leib && !b.drinnen && (!R || ab(b.leib.position, pm) < R));
    // die Pose eines Augen-Bilds: 7 m vor der dichtesten Gruppe (4 m) binnen 20 m am Spieler, Augenhöhe 1,7 m, frei von Grundrissen
    const pose = () => {
        const pts = draussen(20).map((b) => b.leib.position);
        let best = null, bn = 0;
        for (const p of pts) {
            let n = 0;
            for (const q of pts) if (ab(p, q) < 4) n++;
            if (n > bn) (bn = n), (best = p);
        }
        if (!best) return null;
        for (let w = 0; w < 8; w++) {
            const a = Math.atan2(pm.z - best.z, pm.x - best.x) + (w * Math.PI) / 4;
            const cx = best.x + Math.cos(a) * 7, cz = best.z + Math.sin(a) * 7;
            const g = r._imGrundriss(cx, cz, 0.5);
            if (g === "haus" || g === "bau") continue;
            const q2 = (v) => +v.toFixed(2);
            return {
