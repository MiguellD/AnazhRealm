H.seite = {
K: function k2Werkzeug(H, SPEC) {
    const K = { H, SPEC, sicht: "ego" };
    const j = (K.j = H.teil = { leiter: SPEC.leiter, adapter: null, sprossen: {} });
    // DER ADAPTER DER SITZUNG: die Welt nennt ihn in ihrem Log (PUNKTE_SITZUNG_LOG) — Zeile der Probe und Feld des JSON
    K.adapter = () => {
        let z = null;
        try {
            const t = H.fs.readFileSync(String(process.env.PUNKTE_SITZUNG_LOG || ""), "utf8");
            z = (/\[linse-gpu\][^\r\n]*/.exec(t) || [null])[0];
        } catch (_e) {}
        j.adapter = z || "[linse-gpu] ungenannt";
        console.log(j.adapter);
        return j.adapter;
    };
    // ein Funktionsrumpf in der Seite der Welt (r = Welt, T = THREE)
    K.welt = (code, ms) => H.evalWelt(code, ms || 30000);
    // DER MESSORT (spec/profiband/haushalt.json `messorte`): der Aufruf im Text heißt `K.messort("<ort>")` — so liest die Sitzung den Ort
    // und stellt VOR dem Deckel um (punkte.cjs probeOrt); die Sicht vorher über K.sicht ("ego" | "third")
    K.messort = async (ort) => {
        const a = await H.wb("/umstellen", { ort, sicht: K.sicht }, 120000);
        if (!a || a.fehler) throw H.messort(new Error("/umstellen " + ort + ": " + ((a && a.fehler) || "ohne Antwort")), "/umstellen");
        H.zeile("am Messort " + ort + " (" + K.sicht + ")");
        return a;
    };
    K.warte = (ms) => H.schlaf(ms);
    // JE SPROSSE EIN SCHRITT: ein Wurf ist keine Messung (die Sprosse bleibt ohne Ergebnis → UNGEMESSEN beim Namen), ein Wurf des
    // Messorts endet die Probe (die Marke MESSORT); an der Frist bleibt die Sprosse ungemessen, nie geraten
    K.schritt = async (n, f) => {
        if (H.rest() < 2) {
            H.zeile("S" + n + " an der Frist ausgelassen (" + H.sek() + " s)");
            return null;
        }
        try {
            return await f();
        } catch (e) {
            if (e && e.messort) throw e;
            const t = String((e && e.message) || e).split("\n")[0].slice(0, 300);
            H.zeile("S" + n + " warf: " + t);
            j.sprossen[n] = { art: "fehler", text: t };
            return null;
        }
    };
    const kurz = (t) => String(t == null ? "" : t).slice(0, 300);
    // DER STAND NACH JEDER SPROSSE (punkte.cjs keinUrteil (e)): die Ausgabe trägt jedes Ergebnis ganz, ehe die nächste Sprosse misst —
    // reißt danach die Frist oder tötet die Leine die Probe, urteilt die Sprosse aus ihr (daneben geschrieben, dann umbenannt)
    const setze = (n, e) => {
        j.sprossen[n] = e;
        try {
            H.fs.writeFileSync(H.AUS + ".stand", JSON.stringify(j));
            H.fs.renameSync(H.AUS + ".stand", H.AUS);
        } catch (x) {
            H.zeile("Stand: " + String((x && x.message) || x).split("\n")[0]);
        }
        return e;
    };
    K.zahl = (n, o) => setze(n, { art: "zahl", n: o.n, werte: o.werte || {}, ...(o.beleg ? { beleg: kurz(o.beleg) } : {}), ...(o.taeter ? { taeter: kurz(o.taeter) } : {}) });
    K.nicht = (n, o) => setze(n, { art: "nicht", n: o.n, fehlt: kurz(o.fehlt) });
    K.leser = (n, o) => setze(n, { art: "leser", fehlt: kurz(o.fehlt), wo: kurz(o.wo), ...(o.n != null ? { n: o.n } : {}) });
    K.auge = (n, o) => setze(n, { art: "auge", bild: o.bild, pose: kurz(o.pose), vorbild: kurz(o.vorbild || (SPEC.sprossen[n] && SPEC.sprossen[n].auge && SPEC.sprossen[n].auge.vorbild)), ...(o.mass ? { mass: kurz(o.mass) } : {}) });
    // DAS BILD EINER AUGEN-SPROSSE: der Ausgabe-Pfad der Spiel-Kamera (werkbank /bild) an fester Pose { px, py, pz, lx, ly, lz },
    // abgelegt neben der Ausgabe der Probe (<AUS>-S<n>.png; die Abnahme der Werkbank legt ein ROT-Bild als -rot.png daneben)
    K.bild = async (n, pose, mehr) => {
        const datei = String(H.AUS).replace(/\.json$/i, "") + "-S" + n + ".png";
        let a = null;
        try {
            a = await H.wb("/bild", Object.assign({ datei, w: 1280, h: 720 }, pose, mehr || {}), 90000);
        } catch (e) {
            a = { fehler: String((e && e.message) || e) };
        }
        const da = [a && a.datei, datei, datei.replace(/\.png$/i, "-rot.png")].find((f) => f && H.fs.existsSync(f));
        if (!da) throw new Error("kein Bild S" + n + ": " + kurz(a && (a.fehler || a.abnahme)));
        return { datei: da, abnahme: kurz(a && (a.abnahme || a.fehler)) };
    };
    K.ende = () => j;
    return K;
},
SPEC: {"leiter":"mensch.wirtschaft.handel","sprossen":{"1":{"umfang":{"soll":1,"wort":"Ware auf einem Weg mit Fahrer"},"masse":[{"key":"beladen","wort":"Wagen beladen ↔ leer im Bildpaar","soll":1,"richtung":"≥"},{"key":"standLeer","wort":"Gegenlauf: Stand leer binnen Tagesfrist ohne Lieferung","soll":1,"richtung":"≥"}]},"2":{"umfang":{"soll":10,"wort":"Routen zwischen Orten"},"masse":[{"key":"teurer","wort":"Route teurer als die billigste (ORBIS)","soll":0.1,"richtung":"≤"}]},"3":{"umfang":{"soll":100,"wort":"Routen mit Hafen"},"masse":[{"key":"hafenLage","wort":"Hafenlage plausibel","soll":1,"richtung":"≥"},{"key":"beladen","wort":"Schiffe beladen","soll":0.8,"richtung":"≥"}]},"4":{"umfang":{"soll":1000,"wort":"Knoten mit Pässen und Zöllen"},"masse":[{"key":"r","wort":"Dichte ↔ Gravitationsmodell (r)","soll":0.7,"richtung":"≥"},{"key":"sperre","wort":"Hafen-Sperre leert ferne Regale in Reihenfolge","soll":1,"richtung":"≥"}]},"5":{"umfang":{"soll":100000,"wort":"Routen mit Containern"},"masse":[{"key":"fracht","wort":"Frachtbewegungen","soll":10000,"richtung":"≥"},{"key":"reserve","wort":"Verhalten nach Reserven bei 3 Tagen Sperre","soll":1,"richtung":"≥"}]},"6":{"umfang":{"soll":1,"wort":"Welthandel eines Planeten"},"masse":[{"key":"seeweg","wort":"Abweichung Seeweg ↔ kürzeste Passage","soll":0.1,"richtung":"≤"}]},"7":{"umfang":{"soll":1,"wort":"Handel über Sonnensysteme"},"masse":[{"key":"hohmann","wort":"Abweichung Start ↔ Hohmann-Fenster","soll":0.05,"richtung":"≤"}]}}},
STADT: async (r, T, arg) => {
    const s = r.state;
    const pm = s.playerMesh.position;
    const offen = () => {
        const o = typeof r._weltOffen === "function" ? r._weltOffen() : {};
        return !o.leute && !o.leiber;
    };
    const alle = () => [...(r._bewohnerSiedlungen || new Map()).values()].filter((S) => S && S.plan);
    await window.__gebautNach("die Stadt am Messort (Zensus wirtschaft)", {
        fertig: () => alle().some((S) => Array.isArray(S.liste) && S.liste.length > 0) && offen(),
    });
    const SL = alle().sort((a, b) => Math.hypot(a.ox - pm.x, a.oz - pm.z) - Math.hypot(b.ox - pm.x, b.oz - pm.z));
    if (!SL.length) throw new Error("keine Siedlung mit Plan am Messort");
    const plus = (o, k, n) => (o[k] = (o[k] || 0) + (n == null ? 1 : n));
    const imPlan = (S, x, z, saum) => {
        const w = S.plan.welt;
        if (!w) return Math.hypot(x - S.ox, z - S.oz) < 300;
        const lx = x - S.ox, lz = z - S.oz;
        return lx >= w.x0 - saum && lx <= w.x1 + saum && lz >= w.z0 - saum && lz <= w.z1 + saum;
    };
    const Z = {
        siedlungen: SL.length, bewohner: 0, mitWerk: 0, berufe: {}, rollen: {}, slotRollen: {}, haeuser: 0, haendler: 0, staende: 0,
        maerkte: 0, wagen: 0, fahrer: 0, fahrten: 0, fernWagen: 0, laternen: 0, lichtOrte: 0, jahre: [], schmieden: 0, schmiede: null,
        muehlen: 0, inventar: {}, nah: { ox: SL[0].ox, oz: SL[0].oz, name: SL[0].plan.name || null },
    };
    for (const S of SL) {
        const P = S.plan;
        if (Number.isFinite(P.jahr)) Z.jahre.push(P.jahr);
        for (const sl of P.slots || []) {
            Z.haeuser++;
            const ro = typeof sl.rolle === "string" ? sl.rolle : "wohnhaus";
            plus(Z.slotRollen, ro);
            if (/schmied/i.test(ro)) {
                Z.schmieden++;
                if (!Z.schmiede) Z.schmiede = { x: S.ox + sl.x, z: S.oz + sl.z, phi: sl.phi || 0 };
            }
        }
        for (const b of Array.isArray(S.liste) ? S.liste : []) {
            Z.bewohner++;
            plus(Z.berufe, String(b.beruf));
            plus(Z.rollen, String(b.rolle));
            if (b.orte && b.orte.werk) Z.mitWerk++;
            if (/haendler/i.test(String(b.rolle) + " " + String(b.beruf))) Z.haendler++;
        }
        const st = (P.staende || []).length;
        Z.staende += st;
        if (st > 0) Z.maerkte++;
        const lat = (P.laternen || []).length;
        Z.laternen += lat;
        if (lat > 0) Z.lichtOrte++;
        for (const W of (S.verkehr && S.verkehr.wagen) || []) {
            Z.wagen++;
            if (Array.isArray(W.fahrer) && W.fahrer.length) Z.fahrer++;
            if (Number.isFinite(W.ziele)) Z.fahrten += W.ziele;
            const p = W.entry && W.entry.position;
            if (p && !imPlan(S, p.x, p.z, 5)) Z.fernWagen++;
        }
    }
    for (const e of s.architectures || []) {
        if (!e || e._verkehrWagen || !e.mesh || !e.mesh.userData) continue;
        const idle = e.mesh.userData._idleMotion;
        if (!Array.isArray(idle) || !idle.some((x) => x && (x.role === "rad" || x.role === "segel"))) continue;
        const p = e.mesh.position;
