 o.frameMs, takt: q(o.cpuTaktMs).p95, belegung: q(b.belegungMs).p95, pflicht: q(b.pflichtMs).p95, gpu: q(o.gpuMs).p95, gpuN: q(o.gpuMs).n, stempel: q(o.stempel).gueltig, befehle: q(o.befehle).p95, dreiecke: q(o.dreiecke).p95, vram: q(o.vramMB).jetzt, last: s.loadScale, skala: s.szeneSkala, holz: s.holz, wache: q(o.wetterHalt).urteil, wetter: o.wetter, weg: o.bahnM, buehne: o.buehnenTiere, probe: p }));' "$D/b$N-$z.txt" "$(P)")"; }; BOOT() { raeum; rm -f anazhRealmState.json anazhRealmState.json.bak anazhRealmPerf.json; (PORT=$SP node save-server.js > "$D/b$N-save.log" 2>&1 < /dev/null &); for t in $(seq 1 30); do curl -s -o /dev/null http://localhost:$SP/ && break; sleep 1; done; (node scripts/werkbank.cjs start --echt --port $WP --seite http://localhost:$SP --ort wiese > "$D/b$N-werkbank.log" 2>&1 < /dev/null &); for t in $(seq 1 120); do grep -qE "bereit|FEHLER" "$D/b$N-werkbank.log" 2>/dev/null && break; sleep 5; done; grep -m1 "\[linse-gpu\]" "$D/b$N-werkbank.log"; W eval "window.__anazhAutoSettlement = false; return 1" > /dev/null 2>&1; W fenster 1920 1080 > /dev/null 2>&1; }; ENDE() { W stop > /dev/null 2>&1; sleep 3; raeum; }; : richter da232b9996; for N in 1 2 3 4; do BOOT; U wiese ego; Z wiese-ego-steht 30 --ein 10 --ruhe 120 --regler voll --tiere frei; Z wiese-ego-geht 30 --ein 5 --regler voll --tiere frei --wandern bahn; E 'const st = r.state; clearInterval(window.__pbiv); let vor = null; const t = (c, k) => window.dispatchEvent(new KeyboardEvent("keydown", { bubbles: true, code: c, key: k })); window.__pbiv = setInterval(() => { t("ShiftLeft", "Shift"); t("KeyW", "w"); const p = st.playerMesh.position; if (vor && Math.hypot(p.x - vor[0], p.z - vor[1]) < 1) st.yaw += 1.7; vor = [p.x, p.z]; }, 1000); return 1;' > /dev/null; Z wiese-ego-sprint 30 --ein 5 --regler voll --tiere frei; E 'clearInterval(window.__pbiv); for (const [c, k] of [["KeyW", "w"], ["ShiftLeft", "Shift"]]) window.dispatchEvent(new KeyboardEvent("keyup", { bubbles: true, code: c, key: k })