            } catch (x) {
                e = { fehler: String((x && x.message) || x).split("\n")[0].slice(0, 300) };
            }
            e = Object.assign({}, e || { fehler: "die Probe gab nichts zurück" }, { sek: Math.round((Date.now() - t0) / 100) / 10 });
