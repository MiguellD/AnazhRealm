        browser = ns.browser;
        const seite = ns.page;
        seite.setDefaultTimeout(1200000);
        seite.on("pageerror", (e) => erg.fehler.length < 8 && erg.fehler.push(String(e.message || e).split("\n")[0].slice(0, 200)));
