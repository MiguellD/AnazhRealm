        const i = t.search(new RegExp("^(async )?function " + name + "\\(", "m"));
        const e = i < 0 ? -1 : t.indexOf("\n}\n", i);
        if (e < 0) throw new Error(datei + " trägt keine Funktion " + name + " (die Linse am SHA)");
