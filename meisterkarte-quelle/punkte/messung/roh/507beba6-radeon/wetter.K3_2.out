$ C:/Program Files/Git/bin/bash.exe -c set -u; A=$(cygpath -m 'C:\Users\micha\AppData\Local\Temp\claude\w3\pm\meisterkarte-quelle\punkte\messung\roh\507beba6-radeon\wetter.K3_2.json'); D="${A%.json}-werk"; rm -rf "$D"; mkdir -p "$D"; SP=7804; WP=$((SP+20000)); export WERKBANK_PORT=$WP; W() { node scripts/werkbank.cjs "$@"; }; W fenster 1920 1080 > "$D/fenster.txt" 2>&1; W umstellen -258.4 -1132.8 > "$D/umstellen.txt" 2>&1; W eval 'const s = r.state, P = [-258.4, -1132.8], f = r._hydroRiverAt(P[0], P[1]); if (!f) return { fehler: "kein Bach an " + P.join("/") }; window.__wetterSetzen("sunny"); r._naesseTakt(1e6); window.__k3Grund = s.regenStempel && s.regenStempel.slice(); const [ex, ez] = [P[0] - f.flowZ * 7, P[1] + f.flowX * 7], ey = r._voxelSurfaceY(ex, ez) + 1.7; return { vor: r._hydroRiverAt(P[0], P[1]).surfaceY, kamera: [ex, ey, ez, P[0], f.surfaceY, P[1]].map((v) => +v.toFixed(3)) };' > "$D/vor.txt" 2>&1; KAM=$(node -e 'const t = require("fs").readFileSync(process.argv[1], "utf8"); const o = JSON.parse(t.slice(t.indexOf("{"))); console.log(o.ergebnis.kamera.join(" "))' "$D/vor.txt"); echo "KAMERA $KAM"; K='^(wasserSatz|chunk-water-[a-z]+)$'; W bild $KAM --w 1920 --h 1080 --wahl 0 --klasse "$K" --datei "$D/trocken.png" > "$D/bild-trocken.txt" 2>&1; W eval 'const s = r.state, P = [-258.4, -1132.8]; window.__wetterSetzen("stormy"); r._naesseTakt(0); for (let k = 0; k < 240; k++) (s.spielZeit += 5), r._tickRain(); window.__wetterSetzen("sunny"); r._naesseTakt(0); r._pegelTakt(); r._drainDirtyVoxelChunks(); return { nach: r._hydroRiverAt(P[0], P[1]).surfaceY };' > "$D/sturm.txt" 2>&1; W bild $KAM --w 1920 --h 1080 --wahl 0 --klasse "$K" --datei "$D/sturm.png" > "$D/bild-sturm.txt" 2>&1; E=$?; W eval 'const s = r.state; window.__wetterSetzen("sunny"); s.regenStempel = window.__k3Grund; r._pegelTakt(); r._drainDirtyVoxelChunks(); return { zurueck: true };' > "$D/zurueck.txt" 2>&1; echo "BILD $(tr -d '\n' < "$D/bild-sturm.txt" | cut -c1-400)"; node -e 'const fs = require("fs"), d = process.argv[1], j = (f) => { try { const t = fs.readFileSync(d + "/" + f, "utf8"); return JSON.parse(t.slice(t.indexOf("{"))); } catch (_e) { return null; } }; fs.writeFileSync(process.argv[2], JSON.stringify({ trocken: j("trocken.abnahme.json"), sturm: j("sturm.abnahme.json"), vor: (j("vor.txt") || {}).ergebnis || null, nach: (j("sturm.txt") || {}).ergebnis || null }))' "$D" "$A"; exit $E
