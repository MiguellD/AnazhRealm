        if (!da) throw new Error("kein Bild S" + n + ": " + kurz(a && (a.fehler || a.abnahme)));
        return { datei: da, abnahme: kurz(a && (a.abnahme || a.fehler)) };
    };
    K.ende = () => j;
    return K;
},
SPEC: {"leiter":"mensch.macht.grenze","sprossen":{"1":{"umfang":{"soll":1,"wort":"Herrschaftsgebiet"},"masse":[{"key":"grenzeKarte","wort":"Grenze im Bild deckt die Karte (Anteil)","soll":1,"richtung":"≥"},{"key":"burgLage","wort":"Burg, wo Lage und Reichtum sie tragen (Anteil)","soll":1,"richtung":"≥"}]},"2":{"umfang":{"soll":10,"wort":"Gemeinwesen auf 32 × 32 km"},"masse":[{"key":"folgt","wort":"Fluss/Kamm verlegt → Grenze folgt (Anteil von 32 Saaten)","soll":0.7,"richtung":"≥"},{"key":"zeichen","wort":"Grenzzeichen","soll":1,"richtung":"≥"}]},"3":{"umfang":{"soll":100,"wort":"Gemeinwesen in 2 Ebenen (Stadtstaat + Bund)"},"masse":[{"key":"imBand","wort":"Größenverteilung im Band historischer Atlanten (1 = ja)","soll":1,"richtung":"≥"}]},"4":{"umfang":{"soll":1000,"wort":"Jahre Aufstieg und Fall"},"masse":[{"key":"ksP","wort":"Lebensdauer gegen Seshat (KS p)","soll":0.05,"richtung":">"}]},"5":{"auge":{"pose":"stadt-voll: Vogelschau 170 m über dem Platz (25 m südlich), Blick senkrecht auf das Reich","vorbild":"historische Atlanten: Reichsgrenzen im Gelände (Limes, Landwehr) und die Seite der Grenze"}},"6":{"umfang":{"soll":64,"wort":"Orte × 20 Jahre über die Menschenzeit, mit Übersee"},"masse":[{"key":"seshat","wort":"im Seshat-Band","soll":0.8,"richtung":"≥"}]},"7":{"umfang":{"soll":256,"wort":"Saaten mit jeder Stufe von Horde bis Weltordnung"},"masse":[{"key":"stufen","wort":"jede Stufe ≥ 1× (Anteil der Saaten)","soll":0.9,"richtung":"≥"}]},"8":{"umfang":{"soll":100,"wort":"Planeten mit fremden Arten"},"masse":[{"key":"abstand","wort":"Abstand der Ordnungstypen zur Erde ÷ Abstand Erde–Erde","soll":1,"richtung":">","herkunft":"„Abstand zur Erde > Erde–Erde“ ist der Quotient beider Abstände über 1"}]}}},
GRENZE: async (r, T, arg) => {
                const AR = r.constructor;
                const SG = AR._siedlungGesetz && AR._siedlungGesetz();
                if (!SG) return { fehler: "das Siedlungs-Gesetz fehlt im Buch" };
                const pm = r.state.playerMesh.position;
                const reich = AR.Gesetz("fachwerk:siedlungsReich");
                const plaene = [...(r._ortPlaene || new Map()).values()].filter((p) => p && p.ort && Array.isArray(p.slots));
                const nah = plaene.filter((p) => Math.hypot(p.ort.x - pm.x, p.ort.z - pm.z) < 2000);
                const herren = nah.filter((p) => p.slots.some((s) => s.rolle === "burg"));
                // das Reich des Orts mit Herrn: die ganze Stadt (ihre Kacheln) zählt ihre Häuser
                const haeuser = nah.reduce((s, p) => s + p.slots.length, 0);
                const reichM = herren.length ? Math.round(reich(SG, haeuser)) : 0;
                const reichKm2 = +((Math.PI * reichM * reichM) / 1e6).toFixed(3);
                let zeichen = 0;
                const steine = [];
                for (const e of r.state.architectures || []) {
                    const t = e && typeof e.type === "string" ? e.type.toLowerCase() : "";
                    if (t.indexOf("grenz") >= 0 || t.indexOf("markstein") >= 0 || t.indexOf("schlagbaum") >= 0) (zeichen++, e.position && steine.push(e.position));
                }
                // DIE GRENZE IM BILD GEGEN DIE KARTE (Sprosse 1): die Karte ist der Rand des Reichs um den Ort mit Herrn (fachwerk
                // siedlungsReich, reichM), 360 Punkte; ein Punkt steht im Bild, wo ein Grenzzeichen der Szene (Markstein, stamm/siedlung-ort.js
                // _markSteinSetzen) binnen der halben Weite zweier Steine liegt — Band: die Hauptgrenzsteine standen 250–600 m voneinander
                // (Kleindenkmale Baden-Württemberg, Kreisarchiv Bodenseekreis), die halbe größte Weite 300 m
                const herr = herren[0];
                let [randPunkte, imBild, steineAmRand] = [0, 0, 0];
                if (herr && reichM > 0) {
                    for (let k = 0; k < 360; k++) {
                        const a = (k * Math.PI) / 180;
                        const [x, z] = [herr.ort.x + reichM * Math.cos(a), herr.ort.z + reichM * Math.sin(a)];
                        randPunkte++;
