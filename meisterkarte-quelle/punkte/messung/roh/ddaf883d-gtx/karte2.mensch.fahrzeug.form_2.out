                    "ein flugzeug", "einen lastwagen", "einen rennwagen", "einen traktor", "ein segelboot", "eine rakete", "einen bus", "ein motorrad", "einen ochsenkarren", "eine sänfte"];
                const saetze = verb.flatMap((v) => ding.map((d) => v + " " + d));
