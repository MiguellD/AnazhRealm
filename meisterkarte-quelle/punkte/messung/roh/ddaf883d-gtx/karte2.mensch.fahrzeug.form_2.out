H.seite = {
K: function k2Werkzeug(H, SPEC) {
    const K = { H, SPEC, sicht: "ego" };
    const j = (K.j = H.teil = { leiter: SPEC.leiter, adapter: null, sprossen: {} });
    // DER ADAPTER DER SITZUNG: die Welt nennt ihn in ihrem Log (PUNKTE_SITZUNG_LOG) — Zeile der Probe und Feld des JSON
    K.adapter = () => {
        let z = null;
        try {
            const t = H.fs.readFileSync(String(process.env.PUNKTE_SITZUNG_LOG || ""), "utf8");
            z = (/\[linse-gpu\][^\r\n]*/.exec(t) || [null])[0];
        } catch (_e) {}
        j.adapter = z || "[linse-gpu] ungenannt";
        console.log(j.adapter);
        return j.adapter;
    };
    // ein Funktionsrumpf in der Seite der Welt (r = Welt, T = THREE)
    K.welt = (code, ms) => H.evalWelt(code, ms || 30000);
    // DER MESSORT (spec/profiband/haushalt.json `messorte`): der Aufruf im Text heißt `K.messort("<ort>")` — so liest die Sitzung den Ort
    // und stellt VOR dem Deckel um (punkte.cjs probeOrt); die Sicht vorher über K.sicht ("ego" | "third")
    // DIE FRIST IM UMSTELLEN (Runde 4 GTX an 6066c757: 5 von 21 Stationen an stadt-voll „Frist der Probe 64 s gerissen“ ohne eine
    // Zeile nach dem Adapter — die Werkbank ging je Ruf an den Anlauf vor die stehende Stadt, Ruf 2 74,2 s): reißt die Frist, während
    // /umstellen läuft, sagt K.messort es an ihrem Rand selbst (H.fristRiss, die EINE Marke, mit Weg, Ort und Dauer) — der Läufer
    // schreibt den Messort in den Grund (punkte.cjs abbruchVon), nie mehr eine stumme Frist. Die Zeile danach nennt die Takte und den
    // Weg der Werkbank (`anlauf`: „stand“ — die Stadt des Orts stand, kein Anlauf · „gegangen“ — über den Anlauf)
    K.messort = async (ort) => {
        const t = H.sek();
        const rand = setTimeout(() => H.fristRiss("im /umstellen " + ort + " seit " + (H.sek() - t).toFixed(1) + " s (der Ruf ab " + t + " s): der Messort trug die Frist, Abbau"),
            Math.max(0, (H.rest() - 0.25) * 1000));
        let a;
        try {
            a = await H.wb("/umstellen", { ort, sicht: K.sicht }, 120000);
        } finally {
            clearTimeout(rand);
        }
        if (!a || a.fehler) throw H.messort(new Error("/umstellen " + ort + ": " + ((a && a.fehler) || "ohne Antwort")), "/umstellen");
        H.zeile("am Messort " + ort + " (" + K.sicht + ") nach " + (H.sek() - t).toFixed(1) + " s, " + a.takte + " Takte" + (a.anlauf ? ", Anlauf " + a.anlauf : ""));
        return a;
    };
    K.warte = (ms) => H.schlaf(ms);
    // JE SPROSSE EIN SCHRITT: ein Wurf ist keine Messung (die Sprosse bleibt ohne Ergebnis → UNGEMESSEN beim Namen), ein Wurf des
    // Messorts endet die Probe (die Marke MESSORT); an der Frist bleibt die Sprosse ungemessen, nie geraten
    K.schritt = async (n, f) => {
        if (H.rest() < 2) {
            H.zeile("S" + n + " an der Frist ausgelassen (" + H.sek() + " s)");
            return null;
        }
        try {
            return await f();
        } catch (e) {
            if (e && e.messort) throw e;
            const t = String((e && e.message) || e).split("\n")[0].slice(0, 300);
            H.zeile("S" + n + " warf: " + t);
            j.sprossen[n] = { art: "fehler", text: t };
            return null;
        }
    };
    const kurz = (t) => String(t == null ? "" : t).slice(0, 300);
    // DER STAND NACH JEDER SPROSSE (punkte.cjs keinUrteil (e)): die Ausgabe trägt jedes Ergebnis ganz, ehe die nächste Sprosse misst —
    // reißt danach die Frist oder tötet die Leine die Probe, urteilt die Sprosse aus ihr (daneben geschrieben, dann umbenannt)
    const setze = (n, e) => {
        j.sprossen[n] = e;
        try {
            H.fs.writeFileSync(H.AUS + ".stand", JSON.stringify(j));
            H.fs.renameSync(H.AUS + ".stand", H.AUS);
        } catch (x) {
            H.zeile("Stand: " + String((x && x.message) || x).split("\n")[0]);
        }
        return e;
    };
    K.zahl = (n, o) => setze(n, { art: "zahl", n: o.n, werte: o.werte || {}, ...(o.beleg ? { beleg: kurz(o.beleg) } : {}), ...(o.taeter ? { taeter: kurz(o.taeter) } : {}) });
    K.nicht = (n, o) => setze(n, { art: "nicht", n: o.n, fehlt: kurz(o.fehlt) });
    K.leser = (n, o) => setze(n, { art: "leser", fehlt: kurz(o.fehlt), wo: kurz(o.wo), ...(o.n != null ? { n: o.n } : {}) });
    K.auge = (n, o) => setze(n, { art: "auge", bild: o.bild, pose: kurz(o.pose), vorbild: kurz(o.vorbild || (SPEC.sprossen[n] && SPEC.sprossen[n].auge && SPEC.sprossen[n].auge.vorbild)), ...(o.mass ? { mass: kurz(o.mass) } : {}) });
    // DAS BILD EINER AUGEN-SPROSSE: der Ausgabe-Pfad der Spiel-Kamera (werkbank /bild) an fester Pose { px, py, pz, lx, ly, lz },
    // abgelegt neben der Ausgabe der Probe (<AUS>-S<n>.png; die Abnahme der Werkbank legt ein ROT-Bild als -rot.png daneben)
    K.bild = async (n, pose, mehr) => {
        const datei = String(H.AUS).replace(/\.json$/i, "") + "-S" + n + ".png";
        let a = null;
        try {
            a = await H.wb("/bild", Object.assign({ datei, w: 1280, h: 720 }, pose, mehr || {}), 90000);
        } catch (e) {
            a = { fehler: String((e && e.message) || e) };
        }
        const da = [a && a.datei, datei, datei.replace(/\.png$/i, "-rot.png")].find((f) => f && H.fs.existsSync(f));
        if (!da) throw new Error("kein Bild S" + n + ": " + kurz(a && (a.fehler || a.abnahme)));
        return { datei: da, abnahme: kurz(a && (a.abnahme || a.fehler)) };
    };
    K.ende = () => j;
    return K;
},
SPEC: {"leiter":"mensch.fahrzeug.form","sprossen":{"1":{"umfang":{"soll":1,"wort":"Werkstatt-Wagen, in zwei Bauplänen gefahren"},"masse":[{"key":"masseQ","wort":"Masse schwer ÷ leicht","soll":1,"richtung":">"},{"key":"tempoQ","wort":"Tempo nach 6 s Vollgas schwer ÷ leicht","soll":1,"richtung":"<"}]},"2":{"umfang":{"soll":50,"wort":"Baupläne an Land"},"masse":[{"key":"kippQ","wort":"Kippgrenze ÷ statische Formel","soll":1,"tol":0.15}]},"3":{"umfang":{"soll":2,"wort":"Werke mit gebauter Hülle (Floß, Gleiter)","herkunft":"der Richter nennt zwei Werke aus Teilen: das Floß (sinkt/schwimmt) und den Gleiter (fällt/fliegt)"},"masse":[{"key":"flossQ","wort":"Floß: Grenze sinkt ↔ schwimmt ÷ Formel","soll":1,"tol":0.15},{"key":"gleiterQ","wort":"Gleiter: Grenze fällt ↔ fliegt ÷ Formel","soll":1,"tol":0.15}]},"4":{"umfang":{"soll":100,"wort":"Sätze → Fahrzeug"},"masse":[{"key":"aufgabe","wort":"Anteil der Fahrzeuge, die ihre Aufgabe im Spiel erfüllen","soll":0.9,"richtung":"≥"}]},"5":{"umfang":{"soll":1000,"wort":"Kultur-Saaten"},"masse":[{"key":"physik","wort":"Anteil, der den Physik-Test besteht","soll":0.95,"richtung":"≥"},{"key":"ohneMetall","wort":"Anteil ohne Metall, wo die Kultur kein Metall kennt","soll":1,"richtung":"≥"}]},"6":{"auge":{"pose":"Messort wiese: die Ahnen-Reihe nach 500 Jahren Zeitraffer, 12 m vor dem Spieler","vorbild":"Ahnenreihen realer Fahrzeuge (Museum: Kutsche → Benz Patent-Motorwagen → Limousine)"}}}},
ZENSUS: async (r, T, arg) => {
    const s = r.state;
    const VC = window.__vehicleCore;
    const pm = s.playerMesh.position;
    const A = s.architectures || [];
    const typen = {};
    for (const e of A) if (e && typeof e.type === "string") typen[e.type] = (typen[e.type] || 0) + 1;
    const zaehle = (re) => Object.keys(typen).filter((t) => re.test(t)).reduce((a, t) => a + typen[t], 0);
    const medien = {
        land: zaehle(/^fahrzeug_/),
        wasser: zaehle(/boot|schiff|floss|floß|segler|kahn|kogge|dschunke|dhau/i),
        schiene: zaehle(/lok_|lokomotive|waggon|schiene|eisenbahn/i),
        luft: zaehle(/flugzeug|gleiter|ballon|luftschiff|flieger/i),
        tief: zaehle(/tauchboot|u_boot|uboot/i),
        raum: zaehle(/rakete|raumschiff|orbiter|raumkapsel/i),
    };
    const rezepte = [];
    if (VC && VC.PRESETS)
        for (const k of Object.keys(VC.PRESETS)) {
            const pre = VC.PRESETS[k];
            if (!pre || pre.kind !== "vehicle") continue;
            let d = null;
            try {
                d = VC.exportDrive(Object.assign({}, pre.s, pre.fx));
            } catch (_e) {}
            rezepte.push({ k, m: d ? +(+d.mass).toFixed(3) : null, v: d ? +(+d.vmax).toFixed(2) : null });
        }
    const wagen = [];
    let nah = null;
    for (const S of (r._bewohnerSiedlungen || new Map()).values())
        for (const W of (S && S.verkehr && S.verkehr.wagen) || []) {
            wagen.push({ typ: W.typ, steuer: !!(W.b && W.b.amSteuer), faehrt: W.zustand === "faehrt" });
            const e = W.entry;
            if (e && e.position) {
                const d = Math.hypot(e.position.x - pm.x, e.position.z - pm.z);
                if (!nah || d < nah.d) nah = { d, x: e.position.x, y: e.position.y, z: e.position.z };
            }
        }
    const posen = {};
    if (nah) {
        const dx = pm.x - nah.x;
        const dz = pm.z - nah.z;
        const dl = Math.hypot(dx, dz) || 1;
        const cx = nah.x + (dx / dl) * 12;
        const cz = nah.z + (dz / dl) * 12;
        posen.strasse = { px: cx, py: r.getTerrainHeightAt(cx, cz) + 2, pz: cz, lx: nah.x, ly: nah.y + 0.8, lz: nah.z };
    }
    return {
        medien,
        fahrzeugTypen: Object.keys(typen).filter((t) => /^fahrzeug_/.test(t)),
        rezepte,
        physik: new Set(rezepte.map((x) => x.m + "/" + x.v)).size,
        wagen: wagen.length,
        amSteuer: wagen.filter((w) => w.steuer).length,
        faehrt: wagen.filter((w) => w.faehrt).length,
        wagenTypen: [...new Set(wagen.map((w) => w.typ))],
        epochen: VC && Array.isArray(VC.EPOCHE_GESETZ) ? VC.EPOCHE_GESETZ.map((x) => x.id) : [],
        kulturen: VC && VC.CULTURES ? Object.keys(VC.CULTURES).length : 0,
        g: VC && VC.FAHR ? VC.FAHR.G : null,
        strecken: zaehle(/rennstrecke|strecke_/i),
        wettkampf: zaehle(/rennbahn|regatta|wettkampf/i),
        fremd: zaehle(/fremd|alien|xeno/i),
        werke: {
            brunnen: zaehle(/brunnen/i),
            quelle: zaehle(/muehle|mühle|wasserrad|windrad|schoepfrad/i),
            fabrik: zaehle(/fabrik|kraftwerk/i),
            werft: zaehle(/werft|raumhafen/i),
            ketten: A.filter((e) => e && (e.produktion || e.kette)).length,
        },
        posen,
    };
},
FORM: async (r, T, arg) => {
    const s = r.state;
    const VC = window.__vehicleCore;
    const pm = s.playerMesh.position;
    const hh = (x, z) => r.getTerrainHeightAt(x, z);
    if (!VC || !VC.PRESETS || !VC.PRESETS.gt) return { n: 0, fehler: "kein Rezept gt im Fahrzeug-Kern" };
    const x0 = pm.x;
    const z0 = pm.z;
    let t = performance.now();
    const tick = (n) => {
        for (let i = 0; i < n; i++) {
            t += 1000 / 60;
            try {
                r._gameLoopTick(t);
            } catch (_e) {}
        }
    };
    const halte = (vor) => {
        const g = s.verbTafel && s.verbTafel.gehalten;
        if (!g) return;
        for (const k of ["vor", "links", "zurueck", "rechts", "sprint", "jump"]) g[k] = false;
        g.vor = !!vor;
    };
    const stelle = () => {
        pm.set(x0, hh(x0, z0) + 1.2, z0);
        if (s.playerVel && s.playerVel.setValue) s.playerVel.setValue(0, 0, 0);
        if (s._fixedSimPos) s._fixedSimPos.copy(pm);
    };
    const VAR = [
        { name: "leicht", ov: null },
        { name: "schwer", ov: { radstand: 3.4, spur: 1.9, dach: 1.75 } },
    ];
    const laeufe = [];
    for (const v of VAR) {
        stelle();
        tick(4);
        const e = r.spawnArchitecture("fahrzeug_gt", { x: x0, y: hh(x0, z0) + 0.5, z: z0 }, Object.assign({ silent: true, precise: true, rotationY: 0 }, v.ov ? { studioOv: v.ov } : {}));
        if (!e) {
            laeufe.push({ name: v.name, fehler: "das Werk stand nicht" });
            continue;
        }
        try {
            await window.__gebautNach(e);
        } catch (_e) {}
        const g = r._fahrzeugGesetzFor(e);
        const masse = g && g.drive ? g.drive.mass : null;
        const mr = r.mountArchitecture(e);
        if (!mr || !mr.ok) {
            laeufe.push({ name: v.name, masse, fehler: "aufsitzen" });
            try {
                r.removeArchitecture(e);
            } catch (_e) {}
            continue;
        }
        halte(false);
        tick(12);
        const p0 = { x: pm.x, z: pm.z };
        halte(true);
        tick(arg.takte || 360);
        const v1 = Math.hypot(s.playerVel.x(), s.playerVel.z());
        const weg = Math.hypot(pm.x - p0.x, pm.z - p0.z);
        halte(false);
        try {
            r.dismountArchitecture();
        } catch (_e) {}
        try {
            r.removeArchitecture(e);
        } catch (_e) {}
        laeufe.push({ name: v.name, masse, v: +v1.toFixed(3), weg: +weg.toFixed(2) });
    }
    stelle();
    tick(4);
    const [L, S] = laeufe;
    const ok = L && S && Number.isFinite(L.v) && Number.isFinite(S.v) && L.v > 0;
    return { n: ok ? 1 : 0, laeufe, masseQ: ok && L.masse ? S.masse / L.masse : null, tempoQ: ok ? S.v / L.v : null };
},
SAETZE: async (r, T, arg) => {
    const baut = (p) => Array.isArray(p) && ((typeof p[0] === "string" && /^spawn_/.test(p[0])) || p.some(baut));
    const ja = [];
    for (const t of arg.saetze || []) {
        let p = null;
        try {
            p = r.parseChatToDsl(t);
        } catch (_e) {}
        if (p && baut(p.program) && /fahrzeug|wagen|vehicle|boot|karren/i.test(JSON.stringify(p.program))) ja.push(t);
    }
    return { n: ja.length, von: (arg.saetze || []).length, ja: ja.slice(0, 8) };
}
};
