timeout 120 $W umstellen --ort dorf --sicht ego > /dev/null 2>&1
timeout 300 $W lauf 10 --ein 20 --ruhe 120 --regler frei --tiere frei > /dev/null 2>&1
teil NH300 $W eval "window.__m36 = { zelle: [-4, -6], nH: 300, start: 450, maxBilder: 15000 }; $(cat "$K/bericht/2210-messschuld-gtx-6cfce/m36-erstes-haus.js")"
