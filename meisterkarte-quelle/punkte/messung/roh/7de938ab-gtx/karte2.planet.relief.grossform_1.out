                for (const it of k.items)
                    if (ids.has(it.id) && drin(it.x, it.z)) {
                        n.alle++;
                        if (/^blume/.test(a.preset || "")) n.blumen++;
                    }
            }
        return n;
    };
    return { s, A, takt, y, stehen, tage, wetter, trocken, r3, streu };
