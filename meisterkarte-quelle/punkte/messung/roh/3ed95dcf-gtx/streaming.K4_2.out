    tor.ruf = (weg, nutzlast, ms = 120000) =>
        new Promise((ok, nein) => {
            const q = http.request({ host: "127.0.0.1", port: W, path: weg, method: "POST", agent: false, headers: { "Content-Type": "application/json" } }, (a) => {
                let d = "";
