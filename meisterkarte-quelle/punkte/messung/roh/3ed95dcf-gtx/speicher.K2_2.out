        const z = (/\[linse-gpu\][^\r\n]*/.exec(fs.readFileSync(String(process.env.PUNKTE_SITZUNG_LOG), "utf8")) || [null])[0];
        if (z) console.log(z);
        j = (await lauf({ seite, reload, ruf, skript, aus, koord, warte, path, linse: z })) || {};
    } catch (e) {
        j = { fehler: String((e && e.message) || e) };
