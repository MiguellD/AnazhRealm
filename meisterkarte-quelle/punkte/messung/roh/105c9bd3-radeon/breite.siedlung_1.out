            }
            const [S2, w] = [B().get(key), V && V.get(key)];
            const plan = e.los ? (S2 && S2.plan) || (w && w.v2) || null : null;
            const mitPlan = !!(plan && Array.isArray(plan.roads) && plan.roads.length);
            const strassen = mitPlan
