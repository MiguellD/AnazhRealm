    for (const K of voll) B[Math.round(K.rho)].n += K.haeuser.length;
    const pkt = [];
    for (let b = 0; b < B.length; b++) if (B[b] && B[b].n > 0) pkt.push([b, B[b].n / ((B[b].zellen * M * M) / 10000)]);
