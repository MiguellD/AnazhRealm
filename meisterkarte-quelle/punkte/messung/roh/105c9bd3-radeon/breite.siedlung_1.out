            const seite = g[2] * (h[1] - g[1]) - g[3] * (h[0] - g[0]) > 0 ? 0 : 1, a = g[5] + best.t;
            best.s.je[seite].push([Math.max(0, a - e), Math.min(best.s.L, a + e)]);
