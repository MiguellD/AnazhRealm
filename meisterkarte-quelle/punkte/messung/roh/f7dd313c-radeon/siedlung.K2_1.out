teil Z node scripts/diag-settlement.cjs --nur-z
boot
timeout 60 $W fenster 1600 900 > /dev/null 2>&1
timeout 120 $W eval 'const g = r._genesisMitte(); const out = []; for (let cx = -10; cx <= 10; cx++) for (let cz = -10; cz <= 10; cz++) { const i = r._autoSettlementCellInfo(cx, cz); if (!i || !(i.stufe > 0)) continue; const d = Math.hypot(i.x - g.x, i.z - g.z); if (d > 2000) continue; out.push({ cx, cz, nH: i.nH, stufe: i.stufe, d: Math.round(d), site: r._autoSettlementFindSite(i) }); } out.sort((a, b) => a.d - b.d); const c = out.find((o) => o.site); let hill = null; if (c) for (const R of [180, 220, 260]) for (let k = 0; k < 32; k++) { const a = (k / 32) * 2 * Math.PI, x = c.site.x + Math.cos(a) * R, z = c.site.z + Math.sin(a) * R, y = r.getTerrainHeightAt(x, z); if (Number.isFinite(y) && r._landAt(x, z, 0.2) && (!hill || y > hill.y)) hill = { x, y, z, R }; } window.__stadtWahl = { c, hill }; return { seed: r.state.worldMeta && r.state.worldMeta.seed, staedte: out.length, wahl: c ? { cx: c.cx, cz: c.cz, nH: c.nH, stufe: c.stufe, d: c.d } : null, hill };' > "$L/wahl.json" 2>&1; echo '@@PUNKTE@@ WAHL'; cat "$L/wahl.json"; echo
HILL=$(node -e 'const t = require("fs").readFileSync(process.argv[1], "utf8"); const e = JSON.parse(t.slice(t.indexOf("{"))).ergebnis; console.log(e.hill ? e.hill.x.toFixed(1) + " " + e.hill.z.toFixed(1) : "")' "$L/wahl.json" 2> /dev/null)
[ -n "$HILL" ] || { echo '@@PUNKTE@@ KEINE STADT MIT ORT BINNEN 2 KM'; exit 4; }
timeout 300 $W umstellen $HILL > /dev/null 2>&1
for i in $(seq 1 60); do timeout 60 $W eval 'const P = r.state.stlMauer, q = r._autoSettlementQueue, c = window.__stadtWahl.c.site; let haeuser = 0; for (const e of r.state.architectures) if (e && /^haus_/.test(e.type) && Math.hypot(e.position.x - c.x, e.position.z - c.z) < 400) haeuser++; return { mauer: P ? P.top : 0, zug: !!(q && q.plan), pending: r._autoSettlementPendingKey || null, haeuser };' > "$L/stand.json" 2>&1; node -e 'const t = require("fs").readFileSync(process.argv[1], "utf8"); const e = JSON.parse(t.slice(t.indexOf("{"))).ergebnis; process.exit(e.mauer > 0 && !e.zug && !e.pending ? 0 : 1)' "$L/stand.json" 2> /dev/null && break; sleep 5; done
echo '@@PUNKTE@@ STAND'; cat "$L/stand.json"; echo
timeout 60 $W eval 'const c = window.__stadtWahl.c.site; let v2 = null; for (const p of r._ortPlaene.values()) if (p && p.ort && p.mauer && (!v2 || Math.hypot(p.ort.x - c.x, p.ort.z - c.z) < Math.hypot(v2.ort.x - c.x, v2.ort.z - c.z))) v2 = p; if (!v2) return { fehler: "kein Ortsplan mit Mauer" }; const o = v2.ort, cand = []; for (const f of v2.felder || []) cand.push({ x: o.x + f.cx, z: o.z + f.cz, art: "acker" }); for (const fw of v2.feldwege || []) for (const q of fw.pts) cand.push({ x: o.x + q.x, z: o.z + q.z, art: "feldweg" }); let best = null; for (const q of cand) { const d = Math.hypot(q.x - o.x, q.z - o.z); if (d < 70 || d > 260) continue; const y = r.getTerrainHeightAt(q.x, q.z); if (!Number.isFinite(y)) continue; if (!best || y > best.y) best = Object.assign({ y, d: Math.round(d) }, q); } if (!best) return { fehler: "kein Acker oder Feldweg 70–260 m vor der Stadt" }; const cy = r.getTerrainHeightAt(o.x, o.z); return { pose: [best.x, best.y + 1.7, best.z, o.x, cy + 5, o.z].map((v) => +v.toFixed(2)), art: best.art, d: best.d, hoeher: Math.round((best.y - cy) * 10) / 10, segs: v2.mauer.segs.length, tuerme: v2.mauer.towers.length };' > "$L/kamera.json" 2>&1; echo '@@PUNKTE@@ KAMERA'; cat "$L/kamera.json"; echo
K=$(node -e 'const t = require("fs").readFileSync(process.argv[1], "utf8"); const e = JSON.parse(t.slice(t.indexOf("{"))).ergebnis; console.log(e.pose ? e.pose.join(" ") : "")' "$L/kamera.json" 2> /dev/null)
[ -n "$K" ] || { echo '@@PUNKTE@@ KEINE KAMERA'; exit 5; }
