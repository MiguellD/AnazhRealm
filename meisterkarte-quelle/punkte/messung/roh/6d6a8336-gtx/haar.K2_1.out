trap 'git checkout spec/abnahme/soll-tafel.json' EXIT
node scripts/werkbank.cjs fenster 1920 1080 > /dev/null 2>&1
erg() { node -e 'const t = require("fs").readFileSync(0, "utf8"); console.log(JSON.stringify(JSON.parse(t.slice(t.indexOf("{"))).ergebnis))'; }
fehl() { node -e 'const t = require("fs").readFileSync(process.argv[1], "utf8"); let f = null; try { f = JSON.parse(t.slice(t.indexOf("{"))).fehler; } catch (e) {} console.log("BILD " + process.argv[2] + " FEHLER " + String(f || t.trim().split("\n").pop() || "ohne Antwort").replace(/\s+/g, " ").slice(0, 300))' "$1" "$2"; }
node scripts/werkbank.cjs umstellen --ort wiese --sicht third > "$B-umstellen.txt" 2>&1
node scripts/werkbank.cjs bild 0 0 0 0 0 0 --gesicht 0.7 --spieler --wahl 0 --klasse '^spieler:kopf/hair$' --ist haar --datei "$B-arm.png" > "$B-arm.txt" 2>&1; e=$?; echo "BILD arm $e"; [ $e = 0 ] || fehl "$B-arm.txt" arm
node -e 'const AU = require("./scripts/lib/abnahme-urteil.cjs"); const u = AU.sollTafelUrteil(require("./spec/abnahme/soll-tafel.json"), AU.standLeser(process.cwd()).sollQuelle()); const z = u.zeilen.find((x) => x.id === "haar"); console.log("ARM " + JSON.stringify({ urteil: z.urteil, ist: z.ist, band: z.band, grund: z.grund, taeter: z.taeter, teile: z.teile, stand: z.stand }))'
node scripts/werkbank.cjs bild 0 0 0 0 0 0 --gesicht -4 --spieler --wahl 0 --klasse '^spieler:kopf/hair$' --ist haar --datei "$B-third.png" > "$B-third.txt" 2>&1; e=$?; echo "BILD third $e"; [ $e = 0 ] || fehl "$B-third.txt" third
node -e 'const AU = require("./scripts/lib/abnahme-urteil.cjs"); const u = AU.sollTafelUrteil(require("./spec/abnahme/soll-tafel.json"), AU.standLeser(process.cwd()).sollQuelle()); const z = u.zeilen.find((x) => x.id === "haar"); console.log("THIRD " + JSON.stringify({ urteil: z.urteil, ist: z.ist, band: z.band, grund: z.grund, taeter: z.taeter, teile: z.teile, stand: z.stand }))'
