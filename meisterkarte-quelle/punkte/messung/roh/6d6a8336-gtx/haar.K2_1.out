$ C:/Program Files/Git/bin/bash.exe -c A=$(printf %s 'C:\Users\micha\Desktop\AnazhRealm-OMEN\koord-punkte\meisterkarte-quelle\punkte\messung\roh\6d6a8336-gtx\haar.K2_1.json' | tr '\\' /); B="${A%.json}"
