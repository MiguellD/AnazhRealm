$ C:/Program Files/Git/bin/bash.exe C:\Users\micha\AnazhRealm-profiband\artifacts\profiband\werkzeug\gpu-lauf.sh punkte-radeon C:/Program Files/Git/bin/bash.exe -c set -u
WP=7774; SP=$((7774 + 20000)); LP=$((7774 + 20001)); export WERKBANK_PORT=$WP
L="${TEMP:-/tmp}/punkte-g5-$WP"; mkdir -p "$L"; W="node scripts/werkbank.cjs"; SPID=
weg() { timeout 60 $W stop > /dev/null 2>&1; [ -n "$SPID" ] && kill "$SPID" 2> /dev/null; SPID=; for p in $(netstat -ano 2> /dev/null | grep -aE ":($WP|$((WP - 1))|$SP|$LP) .*(LISTEN|ABH)" | awk '{print $5}' | sort -u); do taskkill //F //T //PID "$p" > /dev/null 2>&1; done; rm -f anazhRealmState.json anazhRealmState.json.bak anazhRealmPerf.json; }
trap weg EXIT
boot() { weg; PORT=$SP node save-server.js > "$L/save.log" 2>&1 & SPID=$!; for t in $(seq 1 30); do curl -s -o /dev/null "http://localhost:$SP/" && break; sleep 1; done; $W start --echt --port $WP --seite "http://localhost:$SP" "$@" > "$L/wb.log" 2>&1 & for t in $(seq 1 120); do grep -qE "WERKBANK bereit|FEHLER|Error" "$L/wb.log" && break; sleep 5; done; grep -q "WERKBANK bereit" "$L/wb.log" || { echo "@@PUNKTE@@ START ROT"; tail -5 "$L/wb.log"; exit 3; }; }
teil() { echo "@@PUNKTE@@ $1"; shift; timeout 900 "$@"; echo "@@PUNKTE@@ EXIT $?"; }
echo "@@PUNKTE@@ GARAGE"
git apply "$K/bericht/2110-mk-kopf/garage-mk.diff" && GARAGE_LABOR_PORT=$LP LINSE_GPU=hardware timeout 600 node scripts/diag-garage-mk.cjs
echo "@@PUNKTE@@ EXIT $?"; git checkout -q -- scripts/diag-garage-labor.cjs; rm -f scripts/diag-garage-mk.cjs
boot
teil WELT $W eval "$(cat "$K/bericht/2110-gtx-messschuld/tempo3.js")"
gpu-lauf: Schloss punkte-radeon nach 1 s
@@PUNKTE@@ GARAGE
[linse-gpu] amd/rdna-3
MK2110 {"ruhe":{"fov":34,"arm":9.887502348515564,"v":0},"top":{"fov":43.06800467898982,"arm":11.68048342660783,"v":15.201903992981954,"vmax":15.997810615923129,"nach":6.2,"stabil":false}}
=== G — DIE GARAGE IM KOPFLOS-BROWSER (r184 WebGPU, echte Seite) ===
  ✅ G1 Maus ziehen in Werkstatt und Probefahrt ohne Seitenfehler — 0 Fehler
  ✅ G2 der Fahr-HUD ist ein Flex-Band (Einheit getrennt von der Tastenhilfe) — display flex · Abstand 33 px
  ✅ G3 der Tacho zeigt km/h (×3,6 aus FAHR.kmh) — Anzeige 13 bei 3.62 m/s = 13.0 km/h
  ✅ G4 Preset-Wechsel und erstes Laden: P == DEFAULT_P + Preset + Kultur, Regler == Modell — kein Leck
  ✅ G5 die Kultur lässt sich abwählen (zweiter Klick)
  ✅ G7 die Probefahrt atmet das Tempo wie der Ritt: camera.fov = Ruhe + Tempo aus Fahr-Zustand und vmax, Orbit zurück in 1–1,25 s — {"n":546,"zeigt":0,"quelle":true,"orbit":25,"rueck":1.06}
  ✅ G6 die Probefahrt fährt den gebauten Wagen: kein Lehren-Schild über dem Wagen, in der Werkstatt sind sie zurück — Fahrt 0 Schilder · Werkstatt 6

✅ GRÜN — die Garage: Maus ohne Fehler, HUD als Band, Tacho in km/h, Preset und Kultur ohne Leck, die Probefahrt ohne Lehren.
