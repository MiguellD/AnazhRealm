grep -E 'WERKBANK bereit' "$B-werkbank.log" || { echo 'WERKBANK startet nicht'; tail -5 "$B-werkbank.log"; exit 1; }
node scripts/diag-kreatur-takt.cjs --werkbank $W --proben bewohner
