        if (!da) throw new Error("kein Bild S" + n + ": " + kurz(a && (a.fehler || a.abnahme)));
        return { datei: da, abnahme: kurz(a && (a.abnahme || a.fehler)) };
    };
    K.ende = () => j;
    return K;
},
SPEC: {"leiter":"mensch.macht.recht","sprossen":{"1":{"umfang":{"soll":20,"wort":"Regelbrüche in Sicht der Wache"},"masse":[{"key":"antwort","wort":"Antwort der Wache","soll":0.8,"richtung":"≥"}]},"2":{"umfang":null,"masse":[{"key":"folge","wort":"gesehen → Folge binnen 60 s (verfolgen, strafen)","soll":0.8,"richtung":"≥"},{"key":"ohneFolge","wort":"ungesehen ohne Folge","soll":0.8,"richtung":"≥"}]},"3":{"umfang":{"soll":1000,"wort":"Bewohner"},"masse":[{"key":"gini","wort":"Rate steigt mit Gini (Anteil)","soll":0.8,"richtung":"≥"},{"key":"wache2","wort":"Wache × 2 → Rate fällt (1 = ja)","soll":1,"richtung":"≥"}]},"4":{"umfang":null,"masse":[{"key":"wagenSitz","wort":"Wagen mit Abgaben am Sitz","soll":1,"richtung":"≥"},{"key":"unmut","wort":"Steuer × 2 → Unmut steigt (1 = ja)","soll":1,"richtung":"≥"}]},"5":{"umfang":{"soll":1000,"wort":"Rechtsordnungen"},"masse":[{"key":"folgen","wort":"dieselbe Tat in 10 Gemeinwesen: verschiedene Folgen","soll":5,"richtung":"≥"}]},"6":{"umfang":{"soll":100000000,"wort":"Köpfe unter Verwaltung"},"masse":[{"key":"beamte","wort":"Beamte je Kopf im Seshat-Band","soll":0.8,"richtung":"≥"}]},"7":{"umfang":{"soll":1,"wort":"Planet über alle Epochen mit Recht"},"masse":[{"key":"rho","wort":"Strafmaß ↔ historische Folge ρ","soll":0.6,"richtung":"≥"}]}}},
WACHE: async (r, T, arg) => {
                const pm = r.state.playerMesh.position;
                let [bewohner, waechter, wagen] = [0, 0, 0];
                for (const S of (r._bewohnerSiedlungen || new Map()).values())
                    for (const b of S.liste || []) {
                        bewohner++;
                        if (b.rolle === "waechter" || b.rolle === "nachtwaechter" || b.beruf === "waechter" || b.beruf === "nachtwaechter") waechter++;
                        if (b.amSteuer) wagen++;
                    }
                const G = r._genesisWerkListe && r._genesisWerkListe.plan;
                const g = r._genesisMitte && r._genesisMitte();
                const wp = G && G.wache && g ? [+(g.x + G.wache.x).toFixed(1), +(g.z + G.wache.z).toFixed(1)] : null;
                return { bewohner, waechter, wagen, wachePunkt: wp, spieler: [+pm.x.toFixed(2), +pm.z.toFixed(2)] };
            },
TAT: async (r, T, arg) => {
                const st = r.state;
                const pm = st.playerMesh.position;
                const draussen = [];
                for (const S of (r._bewohnerSiedlungen || new Map()).values()) for (const b of S.liste || []) if (b.leib && !b.drinnen) draussen.push({ b, S });
                const fern = (x, z, R) => draussen.every((q) => Math.hypot(q.b.leib.position.x - x, q.b.leib.position.z - z) >= R);
                let ort = { x: arg.start[0], z: arg.start[1] };
                if (!arg.gesehen) {
                    ort = null;
                    for (const R of [60, 110, 160, 220]) {
                        for (let k = 0; k < 24 && !ort; k++) {
                            const a = (k / 24) * 2 * Math.PI + arg.i;
                            const [x, z] = [arg.start[0] + Math.cos(a) * R, arg.start[1] + Math.sin(a) * R];
                            if (r._landAt(x, z, 0.2) && !(r._imGrundriss && r._imGrundriss(x, z, 2)) && fern(x, z, 45)) ort = { x, z };
                        }
                        if (ort) break;
                    }
                    if (!ort) return { gueltig: false, gesehen: false, grund: "keine Stelle ≥ 45 m von jedem Bewohner draußen binnen 220 m" };
                }
                pm.set(ort.x, r._voxelSurfaceY(ort.x, ort.z) + 1.8, ort.z);
                const P0 = { x: pm.x, z: pm.z };
                const [fx, fz] = [ort.x + 1.2, ort.z + 0.9];
                const zeugen = draussen.filter((q) => Math.hypot(q.b.leib.position.x - fx, q.b.leib.position.z - fz) < r.constructor.BEWOHNER.zeugeM);
