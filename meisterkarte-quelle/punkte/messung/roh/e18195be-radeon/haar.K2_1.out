$ C:/Program Files/Git/bin/bash.exe C:\Users\micha\AnazhRealm-profiband\.claude\worktrees\koordination\meisterkarte-quelle\punkte\werkzeug\gpu-lauf.sh punkte-radeon-3 C:/Program Files/Git/bin/bash.exe -c A=$(printf %s 'C:\Users\micha\AnazhRealm-profiband\.claude\worktrees\koordination\meisterkarte-quelle\punkte\messung\roh\e18195be-radeon\haar.K2_1.json' | tr '\\' /); B="${A%.json}"
S=$(( 7774 )); W=$(( 7774 + 20000 )); export WERKBANK_PORT=$W
raeum() { for p in $(netstat -ano | grep -E ":($S|$W|$((W - 1))) .*(LISTEN|ABH)" | awk '{print $5}' | sort -u); do taskkill //F //T //PID $p > /dev/null 2>&1; done; }
stand() { mkdir -p "$B-stand"; mv anazhRealmState.json anazhRealmState.json.bak anazhRealmPerf.json "$B-stand/" 2> /dev/null; }
ende() { node scripts/werkbank.cjs stop > /dev/null 2>&1; sleep 2; raeum; stand; git checkout spec/abnahme/soll-tafel.json; }
trap ende EXIT; trap 'exit 143' INT TERM
raeum; stand
(PORT=$S node save-server.js > "$B-save.log" 2>&1 &)
for t in $(seq 1 30); do curl -s -o /dev/null -w '%{http_code}' http://localhost:$S/ 2> /dev/null | grep -q 200 && break; sleep 1; done
(node scripts/werkbank.cjs start --echt --port $W --seite http://localhost:$S > "$B-werkbank.log" 2>&1 &)
for t in $(seq 1 120); do grep -qE 'WERKBANK bereit|WERKBANK-FEHLER' "$B-werkbank.log" 2> /dev/null && break; sleep 5; done
grep -E 'WERKBANK bereit|linse-gpu' "$B-werkbank.log" || { echo 'WERKBANK startet nicht'; tail -5 "$B-werkbank.log"; exit 1; }
node scripts/werkbank.cjs fenster 1920 1080 > /dev/null 2>&1
erg() { node -e 'const t = require("fs").readFileSync(0, "utf8"); console.log(JSON.stringify(JSON.parse(t.slice(t.indexOf("{"))).ergebnis))'; }
node scripts/werkbank.cjs umstellen --ort wiese --sicht third > "$B-umstellen.txt" 2>&1
node scripts/werkbank.cjs bild 0 0 0 0 0 0 --gesicht 0.7 --spieler --wahl 0 --klasse '^spieler:kopf/hair$' --ist haar --datei "$B-arm.png" > "$B-arm.txt" 2>&1; echo "BILD arm $?"
node -e 'const AU = require("./scripts/lib/abnahme-urteil.cjs"); const u = AU.sollTafelUrteil(require("./spec/abnahme/soll-tafel.json"), AU.standLeser(process.cwd()).sollQuelle()); const z = u.zeilen.find((x) => x.id === "haar"); console.log("ARM " + JSON.stringify({ urteil: z.urteil, ist: z.ist, band: z.band, grund: z.grund, taeter: z.taeter, teile: z.teile, stand: z.stand }))'
node scripts/werkbank.cjs bild 0 0 0 0 0 0 --gesicht -4 --spieler --wahl 0 --klasse '^spieler:kopf/hair$' --ist haar --datei "$B-third.png" > "$B-third.txt" 2>&1; echo "BILD third $?"
node -e 'const AU = require("./scripts/lib/abnahme-urteil.cjs"); const u = AU.sollTafelUrteil(require("./spec/abnahme/soll-tafel.json"), AU.standLeser(process.cwd()).sollQuelle()); const z = u.zeilen.find((x) => x.id === "haar"); console.log("THIRD " + JSON.stringify({ urteil: z.urteil, ist: z.ist, band: z.band, grund: z.grund, taeter: z.taeter, teile: z.teile, stand: z.stand }))'
