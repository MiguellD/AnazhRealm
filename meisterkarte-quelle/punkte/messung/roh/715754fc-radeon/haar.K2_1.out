node scripts/werkbank.cjs bild 0 0 0 0 0 0 --gesicht -4 --spieler --wahl 0 --klasse '^spieler:kopf/hair$' --ist haar --datei "$B-third.png" > "$B-third.txt" 2>&1; echo "BILD third $?"
