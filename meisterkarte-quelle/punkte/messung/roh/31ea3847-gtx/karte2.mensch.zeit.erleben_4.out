H.seite = {
K: function k2Werkzeug(H, SPEC) {
    const K = { H, SPEC, sicht: "ego" };
    const j = (K.j = H.teil = { leiter: SPEC.leiter, adapter: null, sprossen: {} });
    // DER ADAPTER DER SITZUNG: die Welt nennt ihn in ihrem Log (PUNKTE_SITZUNG_LOG) — Zeile der Probe und Feld des JSON
    K.adapter = () => {
        let z = null;
        try {
            const t = H.fs.readFileSync(String(process.env.PUNKTE_SITZUNG_LOG || ""), "utf8");
            z = (/\[linse-gpu\][^\r\n]*/.exec(t) || [null])[0];
        } catch (_e) {}
        j.adapter = z || "[linse-gpu] ungenannt";
        console.log(j.adapter);
        return j.adapter;
    };
    // ein Funktionsrumpf in der Seite der Welt (r = Welt, T = THREE)
    K.welt = (code, ms) => H.evalWelt(code, ms || 30000);
    // DER MESSORT (spec/profiband/haushalt.json `messorte`): der Aufruf im Text heißt `K.messort("<ort>")` — so liest die Sitzung den Ort
    // und stellt VOR dem Deckel um (punkte.cjs probeOrt); die Sicht vorher über K.sicht ("ego" | "third")
    K.messort = async (ort) => {
        const a = await H.wb("/umstellen", { ort, sicht: K.sicht }, 120000);
        if (!a || a.fehler) throw H.messort(new Error("/umstellen " + ort + ": " + ((a && a.fehler) || "ohne Antwort")), "/umstellen");
        H.zeile("am Messort " + ort + " (" + K.sicht + ")");
        return a;
    };
    K.warte = (ms) => H.schlaf(ms);
    // JE SPROSSE EIN SCHRITT: ein Wurf ist keine Messung (die Sprosse bleibt ohne Ergebnis → UNGEMESSEN beim Namen), ein Wurf des
    // Messorts endet die Probe (die Marke MESSORT); an der Frist bleibt die Sprosse ungemessen, nie geraten
    K.schritt = async (n, f) => {
        if (H.rest() < 2) {
            H.zeile("S" + n + " an der Frist ausgelassen (" + H.sek() + " s)");
            return null;
        }
        try {
            return await f();
        } catch (e) {
            if (e && e.messort) throw e;
            const t = String((e && e.message) || e).split("\n")[0].slice(0, 300);
            H.zeile("S" + n + " warf: " + t);
            j.sprossen[n] = { art: "fehler", text: t };
            return null;
        }
    };
    const kurz = (t) => String(t == null ? "" : t).slice(0, 300);
    // DER STAND NACH JEDER SPROSSE (punkte.cjs keinUrteil (e)): die Ausgabe trägt jedes Ergebnis ganz, ehe die nächste Sprosse misst —
    // reißt danach die Frist oder tötet die Leine die Probe, urteilt die Sprosse aus ihr (daneben geschrieben, dann umbenannt)
    const setze = (n, e) => {
        j.sprossen[n] = e;
        try {
            H.fs.writeFileSync(H.AUS + ".stand", JSON.stringify(j));
            H.fs.renameSync(H.AUS + ".stand", H.AUS);
        } catch (x) {
            H.zeile("Stand: " + String((x && x.message) || x).split("\n")[0]);
        }
        return e;
    };
    K.zahl = (n, o) => setze(n, { art: "zahl", n: o.n, werte: o.werte || {}, ...(o.beleg ? { beleg: kurz(o.beleg) } : {}), ...(o.taeter ? { taeter: kurz(o.taeter) } : {}) });
    K.nicht = (n, o) => setze(n, { art: "nicht", n: o.n, fehlt: kurz(o.fehlt) });
    K.leser = (n, o) => setze(n, { art: "leser", fehlt: kurz(o.fehlt), wo: kurz(o.wo), ...(o.n != null ? { n: o.n } : {}) });
    K.auge = (n, o) => setze(n, { art: "auge", bild: o.bild, pose: kurz(o.pose), vorbild: kurz(o.vorbild || (SPEC.sprossen[n] && SPEC.sprossen[n].auge && SPEC.sprossen[n].auge.vorbild)), ...(o.mass ? { mass: kurz(o.mass) } : {}) });
    // DAS BILD EINER AUGEN-SPROSSE: der Ausgabe-Pfad der Spiel-Kamera (werkbank /bild) an fester Pose { px, py, pz, lx, ly, lz },
    // abgelegt neben der Ausgabe der Probe (<AUS>-S<n>.png; die Abnahme der Werkbank legt ein ROT-Bild als -rot.png daneben)
    K.bild = async (n, pose, mehr) => {
        const datei = String(H.AUS).replace(/\.json$/i, "") + "-S" + n + ".png";
        let a = null;
        try {
            a = await H.wb("/bild", Object.assign({ datei, w: 1280, h: 720 }, pose, mehr || {}), 90000);
        } catch (e) {
            a = { fehler: String((e && e.message) || e) };
        }
        const da = [a && a.datei, datei, datei.replace(/\.png$/i, "-rot.png")].find((f) => f && H.fs.existsSync(f));
        if (!da) throw new Error("kein Bild S" + n + ": " + kurz(a && (a.fehler || a.abnahme)));
        return { datei: da, abnahme: kurz(a && (a.abnahme || a.fehler)) };
    };
    K.ende = () => j;
    return K;
},
SPEC: {"leiter":"mensch.zeit.erleben","sprossen":{"2":{"auge":{"pose":"dorf: 22 m hinter dem Herd (von der Dorfmitte aus), 8 m hoch, Blick über den Brand zum Dorf","vorbild":"Fluchtwege bei Orts- und Flächenbränden (Berichte und Karten großer Stadtbrände, Lübeck 1251, Hamburg 1842): wer flieht wohin, das Feuer nach Bauart und Wind"}},"3":{"umfang":{"soll":10,"wort":"Ereignisarten"},"masse":[{"key":"verschieden","wort":"Abläufe paarweise verschieden (100 Saaten je Art)","soll":0.9,"richtung":"≥"},{"key":"faktor2","wort":"Phasen im Faktor 2 gegen reale Ereignisse der Art","soll":0.85,"richtung":"≥"}]},"4":{"umfang":{"soll":100,"wort":"Ereignisse einer Kette"},"masse":[{"key":"anspringbar","wort":"anspringbar und sichtbar","soll":0.95,"richtung":"≥"}]},"5":{"umfang":{"soll":5,"wort":"Perspektiven derselben Stunde (Bürger, Soldat, Herrscher, Tier)"},"masse":[{"key":"gleichOrt","wort":"jedes Ereignis in allen fünf Bildfolgen am selben Ort zur selben Zeit (±1 s, ±1 m)","soll":1,"richtung":"≥"}]},"6":{"auge":{"pose":"dorf: der Platz","vorbild":"Referenz-Inszenierungen realer Ereignisse (Pompeji 79, die erste Mondlandung 1969)"}}}},
BRAND: async (r, T, arg) => {
                const AR = r.constructor;
                const st = r.state;
                const pm = st.playerMesh.position;
                if (window.__wetterSetzen("sunny") !== "sunny") return { fehler: "das Wetter der Probe gilt nicht: sunny (es gilt " + st.weather + ")" };
                r._naesseTakt(1e6);
                const cs = AR.LIFE_FIELD.cell;
                const draussen = [];
                for (const S of (r._bewohnerSiedlungen || new Map()).values()) for (const b of S.liste || []) if (b.leib && !b.drinnen && Math.hypot(b.leib.position.x - pm.x, b.leib.position.z - pm.z) < 120) draussen.push(b);
                if (!draussen.length) return { fehler: "kein Bewohner draußen binnen 120 m vom Dorf-Platz" };
                const [mx, mz] = [draussen.reduce((s, b) => s + b.leib.position.x, 0) / draussen.length, draussen.reduce((s, b) => s + b.leib.position.z, 0) / draussen.length];
                const [ccx, ccz] = [Math.floor(mx / cs), Math.floor(mz / cs)];
                const nahAn = (x, z, R) => draussen.filter((b) => Math.hypot(b.leib.position.x - x, b.leib.position.z - z) < R);
                let herd = null;
                for (let d = 1; d <= 10 && !herd; d++)
                    for (let i = -d; i <= d && !herd; i++)
                        for (const [cx, cz] of [[ccx + i, ccz - d], [ccx + i, ccz + d], [ccx - d, ccz + i], [ccx + d, ccz + i]]) {
                            const f = r._brandStoff(cx, cz);
                            const [x, z] = [(cx + 0.5) * cs, (cz + 0.5) * cs];
                            if (f && f.zeile && f.zeile.name === "gras" && r._brandFeuchte(f.boden) < f.zeile.brenn.mx && !r._nassAt(x, z) && nahAn(x, z, 30).length) {
                                herd = [x, z];
                                break;
                            }
                        }
                if (!herd) return { fehler: "keine trockene Gras-Zelle mit Bewohnern binnen 30 m (10 Zellen um das Dorf, Zelle " + cs + " m)" };
                const nah = nahAn(herd[0], herd[1], 30);
                const vor = new Map(nah.map((b) => [b, Math.hypot(b.leib.position.x - herd[0], b.leib.position.z - herd[1])]));
                if (!r._brandEntfachen(herd[0], herd[1])) return { fehler: "der Herd fing nicht Feuer (" + herd.map(Math.round).join("/") + ")" };
                const [t0, w0] = [st.spielZeit, performance.now()];
                while (st.spielZeit - t0 < arg.fensterS && performance.now() - w0 < arg.fensterS * 3000) await window.__werkTakt();
                const brennt = [...(st.brandFeld || new Map()).values()].filter((q) => q.t0 !== null).length;
                let [fliehen, naeher] = [0, 0];
                for (const b of nah) {
                    if (!b.leib) continue;
                    const dn = Math.hypot(b.leib.position.x - herd[0], b.leib.position.z - herd[1]);
                    if (dn >= vor.get(b) + 5) fliehen++;
                    if (dn <= vor.get(b) - 2) naeher++;
                }
                const haeuserNah = (st.architectures || []).filter((e) => e && typeof e.type === "string" && e.type.indexOf("haus_") === 0 && Math.hypot(e.position.x - herd[0], e.position.z - herd[1]) < 15).length;
                const cells = (st.worldMeta && st.worldMeta.settlementCells) || {};
                const arten = new Set();
                let akten = 0;
                for (const k in cells) for (const a of (cells[k] && cells[k].akten) || []) (arten.add(a.type), akten++);
                if (brennt > 0) arten.add("brand");
                const [dx, dz] = [herd[0] - mx, herd[1] - mz];
                const l = Math.hypot(dx, dz) || 1;
                const [kx, kz] = [herd[0] + (dx / l) * 22, herd[1] + (dz / l) * 22];
                const ky = r.getTerrainHeightAt(kx, kz);
                const ly = r.getTerrainHeightAt((herd[0] + mx) / 2, (herd[1] + mz) / 2);
                return {
                    herd: herd.map((v) => +v.toFixed(1)),
                    brennt,
                    uhr: +(st.spielZeit - t0).toFixed(1),
                    nah: nah.length,
                    fliehen,
                    naeher,
                    haeuserNah,
                    arten: [...arten],
