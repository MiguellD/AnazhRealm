H.seite = {
K: function k2Werkzeug(H, SPEC) {
    const K = { H, SPEC, sicht: "ego" };
    const j = (K.j = H.teil = { leiter: SPEC.leiter, adapter: null, sprossen: {} });
    // DER ADAPTER DER SITZUNG: die Welt nennt ihn in ihrem Log (PUNKTE_SITZUNG_LOG) — Zeile der Probe und Feld des JSON
    K.adapter = () => {
        let z = null;
        try {
            const t = H.fs.readFileSync(String(process.env.PUNKTE_SITZUNG_LOG || ""), "utf8");
            z = (/\[linse-gpu\][^\r\n]*/.exec(t) || [null])[0];
        } catch (_e) {}
        j.adapter = z || "[linse-gpu] ungenannt";
        console.log(j.adapter);
        return j.adapter;
    };
    // ein Funktionsrumpf in der Seite der Welt (r = Welt, T = THREE)
    K.welt = (code, ms) => H.evalWelt(code, ms || 30000);
    // DER MESSORT (spec/profiband/haushalt.json `messorte`): der Aufruf im Text heißt `K.messort("<ort>")` — so liest die Sitzung den Ort
    // und stellt VOR dem Deckel um (punkte.cjs probeOrt); die Sicht vorher über K.sicht ("ego" | "third")
    K.messort = async (ort) => {
        const a = await H.wb("/umstellen", { ort, sicht: K.sicht }, 120000);
        if (!a || a.fehler) throw H.messort(new Error("/umstellen " + ort + ": " + ((a && a.fehler) || "ohne Antwort")), "/umstellen");
        H.zeile("am Messort " + ort + " (" + K.sicht + ")");
        return a;
    };
    K.warte = (ms) => H.schlaf(ms);
    // JE SPROSSE EIN SCHRITT: ein Wurf ist keine Messung (die Sprosse bleibt ohne Ergebnis → UNGEMESSEN beim Namen), ein Wurf des
    // Messorts endet die Probe (die Marke MESSORT); an der Frist bleibt die Sprosse ungemessen, nie geraten
    K.schritt = async (n, f) => {
        if (H.rest() < 2) {
            H.zeile("S" + n + " an der Frist ausgelassen (" + H.sek() + " s)");
            return null;
        }
        try {
            return await f();
        } catch (e) {
            if (e && e.messort) throw e;
            const t = String((e && e.message) || e).split("\n")[0].slice(0, 300);
            H.zeile("S" + n + " warf: " + t);
            j.sprossen[n] = { art: "fehler", text: t };
            return null;
        }
    };
    const kurz = (t) => String(t == null ? "" : t).slice(0, 300);
    // DER STAND NACH JEDER SPROSSE (punkte.cjs keinUrteil (e)): die Ausgabe trägt jedes Ergebnis ganz, ehe die nächste Sprosse misst —
    // reißt danach die Frist oder tötet die Leine die Probe, urteilt die Sprosse aus ihr (daneben geschrieben, dann umbenannt)
    const setze = (n, e) => {
        j.sprossen[n] = e;
        try {
            H.fs.writeFileSync(H.AUS + ".stand", JSON.stringify(j));
            H.fs.renameSync(H.AUS + ".stand", H.AUS);
        } catch (x) {
            H.zeile("Stand: " + String((x && x.message) || x).split("\n")[0]);
        }
        return e;
    };
    K.zahl = (n, o) => setze(n, { art: "zahl", n: o.n, werte: o.werte || {}, ...(o.beleg ? { beleg: kurz(o.beleg) } : {}), ...(o.taeter ? { taeter: kurz(o.taeter) } : {}) });
    K.nicht = (n, o) => setze(n, { art: "nicht", n: o.n, fehlt: kurz(o.fehlt) });
    K.leser = (n, o) => setze(n, { art: "leser", fehlt: kurz(o.fehlt), wo: kurz(o.wo), ...(o.n != null ? { n: o.n } : {}) });
    K.auge = (n, o) => setze(n, { art: "auge", bild: o.bild, pose: kurz(o.pose), vorbild: kurz(o.vorbild || (SPEC.sprossen[n] && SPEC.sprossen[n].auge && SPEC.sprossen[n].auge.vorbild)), ...(o.mass ? { mass: kurz(o.mass) } : {}) });
    // DAS BILD EINER AUGEN-SPROSSE: der Ausgabe-Pfad der Spiel-Kamera (werkbank /bild) an fester Pose { px, py, pz, lx, ly, lz },
    // abgelegt neben der Ausgabe der Probe (<AUS>-S<n>.png; die Abnahme der Werkbank legt ein ROT-Bild als -rot.png daneben)
    K.bild = async (n, pose, mehr) => {
        const datei = String(H.AUS).replace(/\.json$/i, "") + "-S" + n + ".png";
        let a = null;
        try {
            a = await H.wb("/bild", Object.assign({ datei, w: 1280, h: 720 }, pose, mehr || {}), 90000);
        } catch (e) {
            a = { fehler: String((e && e.message) || e) };
        }
        const da = [a && a.datei, datei, datei.replace(/\.png$/i, "-rot.png")].find((f) => f && H.fs.existsSync(f));
        if (!da) throw new Error("kein Bild S" + n + ": " + kurz(a && (a.fehler || a.abnahme)));
        return { datei: da, abnahme: kurz(a && (a.abnahme || a.fehler)) };
    };
    K.ende = () => j;
    return K;
},
SPEC: {"leiter":"mensch.zeit.spanne","sprossen":{"1":{"auge":{"pose":"genesis: vier Orte (Same 7, 12 Häuser) der Jahre 1300/1600/1800/1950, je die Kamera 70 m vor ihrer Mitte, 22 m über dem Grund","vorbild":"datierte Ansichten derselben Stadt zu vier Zeiten (Merian-Stich um 1640, Ansichten um 1800, Fotos um 1900 und 1950) — die Folge der vier Bilder"}},"2":{"auge":{"pose":"genesis: 40 m vor der Mitte, 30 m hoch","vorbild":"datierte Bildquellen eines Orts über 3 000 Jahre (Rekonstruktionen je 50 Jahre)"}},"3":{"auge":{"pose":"genesis: 40 m vor der Mitte, 30 m hoch","vorbild":"Grabungsbefunde und Rekonstruktionen von Lager, Dorf ohne Metall und Tell (Çatalhöyük, Jericho)"}},"4":{"auge":{"pose":"genesis: 40 m vor der Mitte, 30 m hoch","vorbild":"Zeitraffer gewachsener Städte (Luftbildreihen 1950–2020) — Anfang und Ende blind geordnet"}},"5":{"auge":{"pose":"genesis: 40 m vor der Mitte, 30 m hoch","vorbild":"Rekonstruktionen jeder Kultur am Ort über 300 000 Jahre; Fremdwelt-Probe (R10) für die Zukunft"}},"6":{"auge":{"pose":"genesis: 40 m vor der Mitte, 30 m hoch","vorbild":"datierte Bildquellen und Rekonstruktionen je Ort und Epoche (2AFC)"}},"7":{"auge":{"pose":"genesis: 40 m vor der Mitte, 30 m hoch","vorbild":"Fremdwelt-Probe (R10): fünf Halte eines Orts einer fremden Art"}}}},
HALTE: async (r, T, arg) => {
                const AR = r.constructor;
                const ep = AR.Gesetz("fachwerk:epocheImJahr");
                const t0 = performance.now();
                const sig = (p) => JSON.stringify([p.jahr, p.region, p.groesse, p.slots.length, (p.roads || []).length, p.slots.slice(0, 3).map((s) => [s.kultur, Math.round(s.x), Math.round(s.z)])]);
                const cache = new Map();
                const ort = async (seed, epoche) => {
                    const k = seed + "|" + epoche;
                    if (!cache.has(k)) {
                        const p = await r._foundryRequestSettlement({ seed, nH: arg.nH, epoche });
                        if (!p) throw new Error("die Foundry ist kalt: export-settlement null (Same " + seed + ", " + epoche + ")");
                        cache.set(k, sig(p));
                    }
                    return cache.get(k);
                };
                let z = 2654435761;
                const rnd = () => ((z = (Math.imul(z, 1103515245) + 12345) >>> 0) / 4294967296);
                const je = {};
                for (const [n, q] of Object.entries(arg.reihen)) {
                    const sigs = new Set();
                    const epochen = new Set();
                    for (let i = 0; i < q.n; i++) {
                        const jahr = q.zufall ? Math.round(q.zufall[0] + rnd() * (q.zufall[1] - q.zufall[0])) : q.von + i * q.schritt;
                        const e = ep(jahr);
                        epochen.add(e);
                        sigs.add(await ort(q.orte ? arg.seed + (i % q.orte) : arg.seed, e));
                    }
                    je[n] = { halte: q.n, verschieden: sigs.size, epochen: [...epochen] };
                }
                // die Welt ist eine Funktion: derselbe Auftrag ein zweites Mal, derselbe Ort
                const p2 = await r._foundryRequestSettlement({ seed: arg.seed, nH: arg.nH, epoche: ep(1300) });
                const rein = !!p2 && sig(p2) === (await ort(arg.seed, ep(1300)));
                const g = r._genesisMitte();
                const y = r.getTerrainHeightAt(g.x, g.z);
                return { je, rein, exporte: cache.size + 1, ms: Math.round(performance.now() - t0), pose: { px: g.x, py: +(y + 30).toFixed(2), pz: g.z + 40, lx: g.x, ly: +y.toFixed(2), lz: g.z } };
            },
VIER: async (r, T, arg) => {
                const AR = r.constructor;
                const ep = AR.Gesetz("fachwerk:epocheImJahr");
                const t0 = performance.now();
                const g = r._genesisMitte();
                const land = (x, z) => r._landAt(x, z, 0.2);
                const hoch = (x, z) => r.getTerrainHeightAt(x, z);
                const kand = [];
                for (const R of [500, 650, 800])
                    for (let k = 0; k < 24; k++) {
                        const a = (k / 24) * 2 * Math.PI;
                        const [x, z] = [g.x + Math.cos(a) * R, g.z + Math.sin(a) * R];
                        const ys = [0, 1, 2, 3, 4, 5, 6, 7].map((j) => [x + Math.cos(j * 0.785) * 70, z + Math.sin(j * 0.785) * 70]);
                        if (!land(x, z) || !ys.every(([u, v]) => land(u, v))) continue;
                        const hs = ys.map(([u, v]) => hoch(u, v));
                        kand.push({ x, z, hang: Math.max(...hs) - Math.min(...hs) });
                    }
                kand.sort((a, b) => a.hang - b.hang);
                if (kand.length < arg.jahre.length) return { fehler: "nur " + kand.length + " ebene Stellen 500–800 m vor dem Genesis-Ort" };
                const orte = [];
                const abgesagt = [];
                for (const jahr of arg.jahre) {
                    let res = null;
                    while (!res && kand.length && performance.now() - t0 < arg.fristMs) {
                        const c = kand.shift();
                        if (orte.some((o) => Math.hypot(o.x - c.x, o.z - c.z) < 300)) continue;
                        res = await r.spawnSettlement({ seed: arg.seed, nH: arg.nH, jahr, position: { x: c.x, y: 0, z: c.z } });
                        if (!res || !res.placed || !res.mitte) (abgesagt.push(Math.round(c.x) + "/" + Math.round(c.z)), (res = null));
                    }
