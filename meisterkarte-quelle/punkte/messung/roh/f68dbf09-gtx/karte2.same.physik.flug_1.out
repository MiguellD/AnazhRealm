                                if (t > 0.1 && K.v[1] <= 0 && mn - r._koerperBodenUnter(mx, mn + 0.5, mz) <= F.spalt) weite = (K.p[0] - bahn.x0) * bahn.ux + (K.p[2] - bahn.z0) * bahn.uz;
