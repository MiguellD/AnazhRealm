K: function k2Werkzeug(H, SPEC) {
    const K = { H, SPEC, sicht: "ego" };
    const j = (K.j = H.teil = { leiter: SPEC.leiter, adapter: null, sprossen: {} });
    // DER ADAPTER DER SITZUNG: die Welt nennt ihn in ihrem Log (PUNKTE_SITZUNG_LOG) — Zeile der Probe und Feld des JSON
    K.adapter = () => {
        let z = null;
        try {
            const t = H.fs.readFileSync(String(process.env.PUNKTE_SITZUNG_LOG || ""), "utf8");
            z = (/\[linse-gpu\][^\r\n]*/.exec(t) || [null])[0];
        } catch (_e) {}
        j.adapter = z || "[linse-gpu] ungenannt";
        console.log(j.adapter);
        return j.adapter;
    };
    // ein Funktionsrumpf in der Seite der Welt (r = Welt, T = THREE)
    K.welt = (code, ms) => H.evalWelt(code, ms || 30000);
    // DER MESSORT (spec/profiband/haushalt.json `messorte`): der Aufruf im Text heißt `K.messort("<ort>")` — so liest die Sitzung den Ort
    // und stellt VOR dem Deckel um (punkte.cjs probeOrt); die Sicht vorher über K.sicht ("ego" | "third")
    K.messort = async (ort) => {
        const a = await H.wb("/umstellen", { ort, sicht: K.sicht }, 120000);
        if (!a || a.fehler) throw H.messort(new Error("/umstellen " + ort + ": " + ((a && a.fehler) || "ohne Antwort")), "/umstellen");
        H.zeile("am Messort " + ort + " (" + K.sicht + ")");
        return a;
    };
    K.warte = (ms) => H.schlaf(ms);
    // JE SPROSSE EIN SCHRITT: ein Wurf ist keine Messung (die Sprosse bleibt ohne Ergebnis → UNGEMESSEN beim Namen), ein Wurf des
    // Messorts endet die Probe (die Marke MESSORT); an der Frist bleibt die Sprosse ungemessen, nie geraten
    K.schritt = async (n, f) => {
        if (H.rest() < 2) {
            H.zeile("S" + n + " an der Frist ausgelassen (" + H.sek() + " s)");
            return null;
        }
        try {
            return await f();
        } catch (e) {
            if (e && e.messort) throw e;
            const t = String((e && e.message) || e).split("\n")[0].slice(0, 300);
            H.zeile("S" + n + " warf: " + t);
            j.sprossen[n] = { art: "fehler", text: t };
            return null;
        }
    };
    const kurz = (t) => String(t == null ? "" : t).slice(0, 300);
    K.zahl = (n, o) =>
        (j.sprossen[n] = { art: "zahl", n: o.n, werte: o.werte || {}, ...(o.beleg ? { beleg: kurz(o.beleg) } : {}), ...(o.taeter ? { taeter: kurz(o.taeter) } : {}) });
    K.nicht = (n, o) => (j.sprossen[n] = { art: "nicht", n: o.n, fehlt: kurz(o.fehlt) });
    K.leser = (n, o) => (j.sprossen[n] = { art: "leser", fehlt: kurz(o.fehlt), wo: kurz(o.wo), ...(o.n != null ? { n: o.n } : {}) });
    K.auge = (n, o) => (j.sprossen[n] = { art: "auge", bild: o.bild, pose: kurz(o.pose), vorbild: kurz(o.vorbild || (SPEC.sprossen[n] && SPEC.sprossen[n].auge && SPEC.sprossen[n].auge.vorbild)), ...(o.mass ? { mass: kurz(o.mass) } : {}) });
    // DAS BILD EINER AUGEN-SPROSSE: der Ausgabe-Pfad der Spiel-Kamera (werkbank /bild) an fester Pose { px, py, pz, lx, ly, lz },
    // abgelegt neben der Ausgabe der Probe (<AUS>-S<n>.png; die Abnahme der Werkbank legt ein ROT-Bild als -rot.png daneben)
    K.bild = async (n, pose, mehr) => {
        const datei = String(H.AUS).replace(/\.json$/i, "") + "-S" + n + ".png";
        let a = null;
        try {
            a = await H.wb("/bild", Object.assign({ datei, w: 1280, h: 720 }, pose, mehr || {}), 90000);
        } catch (e) {
            a = { fehler: String((e && e.message) || e) };
        }
        const da = [a && a.datei, datei, datei.replace(/\.png$/i, "-rot.png")].find((f) => f && H.fs.existsSync(f));
        if (!da) throw new Error("kein Bild S" + n + ": " + kurz(a && (a.fehler || a.abnahme)));
        return { datei: da, abnahme: kurz(a && (a.abnahme || a.fehler)) };
    };
    K.ende = () => j;
    return K;
},
SPEC: {"leiter":"mensch.fahrzeug.lenker","sprossen":{"1":{"umfang":{"soll":10,"wort":"Fahrer am Steuer auf den Wegen"},"masse":[{"key":"kollisionen","wort":"Kollisionen (Wagen, Leib, Bau)","soll":0,"richtung":"≤"},{"key":"zeitluecke","wort":"Zeitlücke zum Vorderen im Median in s","von":1,"bis":3},{"key":"reisetempo","wort":"Reisetempo ÷ erlaubtes","soll":0.8,"richtung":"≥"},{"key":"stillstand","wort":"Stillstände ohne Anlass","soll":0,"richtung":"≤"},{"key":"stunden","wort":"Spielstunden Verkehr der Messung","soll":1,"richtung":"≥","herkunft":"„1 h“: eine Stunde der Welt-Uhr, `_bewohnerStundeSek()` = 60 min Tag ÷ 24 = 150 s Spielzeit (stamm/siedlung-bewohner.js:2422)"}]},"2":{"umfang":{"soll":100,"wort":"Fahrer mit Charakter"},"masse":[{"key":"tempoAuc","wort":"Tempo vorsichtig ↔ eilig trennbar (AUC)","soll":0.5,"richtung":">","herkunft":"„trennbar“: besser als der Zufall — AUC 0,5 heißt ununterscheidbar (wie 50 % im Zwei-Wege-Zwang, R11)"},{"key":"zeitluecke","wort":"Zeitlücke zum Vorderen im Median in s","von":1,"bis":3}]},"3":{"umfang":{"soll":20,"wort":"Rennstrecken mit Rennfahrer"},"masse":[{"key":"umlaufQ","wort":"bester Umlauf ÷ Optimum","soll":1.05,"richtung":"≤"}]},"4":{"umfang":{"soll":2,"wort":"Kapitän und Pilot (Wasser- und Luftfahrzeug mit Lenker)","herkunft":"die Aufzählung „Kapitän und Pilot“ zählt zwei Lenker: einen zu Wasser, einen in der Luft"},"masse":[{"key":"regattaRang","wort":"Regatta: Rang folgt Können (Spearman r)","soll":0,"richtung":">"},{"key":"landung","wort":"Landungen bei 15 kn Seitenwind gelungen","soll":0.95,"richtung":"≥"}]},"5":{"umfang":{"soll":1,"wort":"Wettkampf mit Gefährt"},"masse":[{"key":"windschatten","wort":"Windschatten und Überholen treten auf (1 ja)","soll":1,"richtung":"≥"},{"key":"siegerQ","wort":"Siegerzeit je km ÷ Rekordklasse","soll":1,"tol":0.15},{"key":"gegenlauf","wort":"Gegenlauf ohne Windschatten: das Feld zieht sich auseinander (1 ja)","soll":1,"richtung":"≥"}]},"6":{"umfang":{"soll":100,"wort":"fremde Lenker in fremden Medien"},"masse":[{"key":"optimumQ","wort":"Lauf ÷ Optimum","soll":1.1,"richtung":"≤"}]}}},
ZENSUS: async (r, T, arg) => {
    const s = r.state;
    const VC = window.__vehicleCore;
    const pm = s.playerMesh.position;
    const A = s.architectures || [];
    const typen = {};
    for (const e of A) if (e && typeof e.type === "string") typen[e.type] = (typen[e.type] || 0) + 1;
    const zaehle = (re) => Object.keys(typen).filter((t) => re.test(t)).reduce((a, t) => a + typen[t], 0);
    const medien = {
        land: zaehle(/^fahrzeug_/),
        wasser: zaehle(/boot|schiff|floss|floß|segler|kahn|kogge|dschunke|dhau/i),
        schiene: zaehle(/lok_|lokomotive|waggon|schiene|eisenbahn/i),
        luft: zaehle(/flugzeug|gleiter|ballon|luftschiff|flieger/i),
        tief: zaehle(/tauchboot|u_boot|uboot/i),
        raum: zaehle(/rakete|raumschiff|orbiter|raumkapsel/i),
    };
    const rezepte = [];
    if (VC && VC.PRESETS)
        for (const k of Object.keys(VC.PRESETS)) {
            const pre = VC.PRESETS[k];
            if (!pre || pre.kind !== "vehicle") continue;
            let d = null;
            try {
                d = VC.exportDrive(Object.assign({}, pre.s, pre.fx));
            } catch (_e) {}
            rezepte.push({ k, m: d ? +(+d.mass).toFixed(3) : null, v: d ? +(+d.vmax).toFixed(2) : null });
        }
    const wagen = [];
    let nah = null;
    for (const S of (r._bewohnerSiedlungen || new Map()).values())
        for (const W of (S && S.verkehr && S.verkehr.wagen) || []) {
            wagen.push({ typ: W.typ, steuer: !!(W.b && W.b.amSteuer), faehrt: W.zustand === "faehrt" });
            const e = W.entry;
            if (e && e.position) {
                const d = Math.hypot(e.position.x - pm.x, e.position.z - pm.z);
                if (!nah || d < nah.d) nah = { d, x: e.position.x, y: e.position.y, z: e.position.z };
            }
        }
    const posen = {};
    if (nah) {
        const dx = pm.x - nah.x;
        const dz = pm.z - nah.z;
        const dl = Math.hypot(dx, dz) || 1;
        const cx = nah.x + (dx / dl) * 12;
        const cz = nah.z + (dz / dl) * 12;
        posen.strasse = { px: cx, py: r.getTerrainHeightAt(cx, cz) + 2, pz: cz, lx: nah.x, ly: nah.y + 0.8, lz: nah.z };
    }
    return {
        medien,
        fahrzeugTypen: Object.keys(typen).filter((t) => /^fahrzeug_/.test(t)),
        rezepte,
        physik: new Set(rezepte.map((x) => x.m + "/" + x.v)).size,
        wagen: wagen.length,
        amSteuer: wagen.filter((w) => w.steuer).length,
        faehrt: wagen.filter((w) => w.faehrt).length,
        wagenTypen: [...new Set(wagen.map((w) => w.typ))],
        epochen: VC && Array.isArray(VC.EPOCHE_GESETZ) ? VC.EPOCHE_GESETZ.map((x) => x.id) : [],
        kulturen: VC && VC.CULTURES ? Object.keys(VC.CULTURES).length : 0,
        g: VC && VC.FAHR ? VC.FAHR.G : null,
        strecken: zaehle(/rennstrecke|strecke_/i),
        wettkampf: zaehle(/rennbahn|regatta|wettkampf/i),
        fremd: zaehle(/fremd|alien|xeno/i),
        werke: {
            brunnen: zaehle(/brunnen/i),
            quelle: zaehle(/muehle|mühle|wasserrad|windrad|schoepfrad/i),
            fabrik: zaehle(/fabrik|kraftwerk/i),
            werft: zaehle(/werft|raumhafen/i),
            ketten: A.filter((e) => e && (e.produktion || e.kette)).length,
        },
        posen,
    };
},
VERKEHR: async (r, T, arg) => {
    const s = r.state;
    const A = r.constructor;
    const V = A.VERKEHR;
    const SS = [...(r._bewohnerSiedlungen || new Map()).values()].filter((S) => S && S.verkehr && Array.isArray(S.verkehr.wagen) && S.verkehr.wagen.length);
    const WW = SS.flatMap((S) => S.verkehr.wagen);
    if (!WW.length) return { n: 0, wagen: 0, fehler: "kein Verkehr am Messort" };
    const stoss = () =>
        SS.reduce((a, S) => {
            const st = (S.verkehr.zahl && S.verkehr.zahl.stoss) || {};
            return a + (st.wagen || 0) + (st.leib || 0) + (st.bau || 0);
        }, 0);
    const fest = () => SS.reduce((a, S) => a + ((S.verkehr.zahl && S.verkehr.zahl.fest) || 0), 0);
    const km = () => SS.reduce((a, S) => a + ((S.verkehr.zahl && S.verkehr.zahl.km) || 0), 0);
    const stundeS = r._bewohnerStundeSek();
    const schrittMs = A.TAKT_DECKEL_S * 1000;
    const s0 = stoss();
    const f0 = fest();
    const z0 = s.spielZeit;
    const weg0 = WW.map((W) => W.weg || 0);
    const fahrS = WW.map(() => 0);
    const luecken = [];
    let steuerMax = 0;
    let takte = 0;
    let fehler = 0;
    let verkehrS = 0;
    let uhr = performance.now();
    const wand0 = performance.now();
    const ende = wand0 + (arg.ms || 20000);
    while (verkehrS < stundeS && performance.now() < ende) {
        for (let k = 0; k < 5 && verkehrS < stundeS; k++) {
            const sz = s.spielZeit;
            const k0 = km();
            uhr += schrittMs;
            try {
                r._gameLoopTick(uhr);
            } catch (_e) {
                fehler++;
            }
            takte++;
            const dt = s.spielZeit - sz;
            const lief = km() > k0;
            if (lief) verkehrS += dt;
            let steuer = 0;
            for (let i = 0; i < WW.length; i++) {
                const W = WW[i];
                if (W.b && W.b.amSteuer) steuer++;
                const fz = W.entry && W.entry._fahr;
                if (!lief || W.zustand !== "faehrt" || !fz) continue;
                fahrS[i] += dt;
                const v = fz.speed;
                const o = W.vorder;
                if (o && v > 2 && o.gap > 0 && o.gap < V.folgeM && o.v > 1) luecken.push(o.gap / v);
            }
            if (steuer > steuerMax) steuerMax = steuer;
        }
        await window.sleep();
    }
    const wandS = (performance.now() - wand0) / 1000;
    const weg = WW.reduce((a, W, i) => a + Math.max(0, (W.weg || 0) - weg0[i]), 0);
    const zeit = fahrS.reduce((a, x) => a + x, 0);
    luecken.sort((a, b) => a - b);
    const mitte = luecken.length ? luecken[Math.floor(luecken.length / 2)] : null;
    return {
        n: steuerMax,
        wagen: WW.length,
        fahrer: WW.reduce((a, W) => a + ((W.fahrer && W.fahrer.length) || 1), 0),
        kollisionen: stoss() - s0,
        stillstand: fest() - f0,
        reisetempo: zeit > 0 ? weg / zeit / V.tempoMs : 0,
        zeitluecke: mitte,
        luecken: luecken.length,
        stunden: +(verkehrS / stundeS).toFixed(3),
        stundeS,
        verkehrS: +verkehrS.toFixed(1),
        spielS: +(s.spielZeit - z0).toFixed(1),
        wandS: +wandS.toFixed(1),
        msJeTakt: takte ? +((wandS * 1000) / takte).toFixed(1) : null,
        takte,
        fehler,
        wegM: Math.round(weg),
    };
}
};
H.fahre(async (H) => {
