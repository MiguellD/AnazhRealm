$ C:\Program Files\nodejs\node.exe -e (async function folge(plan) {
    const fs = require("fs");
    const path = require("path");
    const cp = require("child_process");
    const crypto = require("crypto");
    const [AUS, KOORD] = process.argv.slice(1);
    const DIR = AUS + ".d";
    fs.mkdirSync(DIR, { recursive: true });
    const WB = path.join("scripts", "werkbank.cjs");
    const P = String(process.env.WERKBANK_PORT);
    const aus = { plan: plan.name, adapter: null, schritte: {}, dateien: {} };
    // @DIR@ · @KOORD@ · @T:<name>@ (ein Text aus plan.texte) · @<schritt>.<i>@ (das i-te Feld des Ergebnisses eines früheren Schritts)
    const ers = (s) =>
        String(s)
            .replace(/@T:([A-Z_]+)@/g, (_m, n) => plan.texte[n])
            .split("@DIR@").join(DIR)
            .split("@KOORD@").join(KOORD)
            .replace(/@([a-z0-9-]+)\.(\d+)@/g, (_m, n, i) => {
                const e = aus.schritte[n] && aus.schritte[n].json && aus.schritte[n].json.ergebnis;
                if (!Array.isArray(e) || e[+i] == null) throw new Error("Schritt " + n + " trägt kein Feld " + i + ": " + JSON.stringify(e));
                return String(e[+i]);
            });
    const duenn = (o) => (o == null ? null : JSON.parse(JSON.stringify(o, (_k, v) => (typeof v === "string" && v.length > 4096 ? undefined : v))));
    const json = (t) => {
        const s = String(t || "");
        const e = s.lastIndexOf("}");
        for (const i of [s.startsWith("{") ? 0 : -1, s.indexOf("\n{")])
            if (i >= 0 && e > i)
                try {
                    return JSON.parse(s.slice(i, e + 1));
                } catch (_e) {
                    /* der nächste Anfang */
                }
        return null;
    };
    const wb = (args, ms) =>
        cp.spawnSync(process.execPath, [WB, ...args, "--port", P], { encoding: "utf8", timeout: ms || 900000, maxBuffer: 1 << 28 });
    let code = 0;
    try {
        aus.adapter = (/\[linse-gpu\][^\r\n]*/.exec(fs.readFileSync(String(process.env.PUNKTE_SITZUNG_LOG), "utf8")) || [null])[0];
        for (const s of plan.schritte) {
            let args = (s.args || []).map(ers);
            if (s.probe) {
                // eine Seiten-Probe aus einer Datei; ihr git-Blob ist fest, damit eine geänderte Probe nie still mitmisst
                const roh = fs.readFileSync(ers(s.probe));
                const blob = crypto.createHash("sha1").update("blob " + roh.length + "\0").update(roh).digest("hex");
                if (blob !== s.blob) throw new Error("Probe " + s.probe + " ist Blob " + blob + ", die Station kennt " + s.blob);
                args = ["eval", roh.toString("utf8")];
            }
            const r = wb(args, s.ms);
            // der Rest der Ausgabe steht IMMER (29.10.: die Urteils-Zeile eines Werkzeugs, das daneben JSON druckt, fiel sonst weg)
            const e = { exit: r.status, json: duenn(json(r.stdout)), rest: String((r.stdout || "") + (r.stderr || "")).slice(-1500) };
            aus.schritte[s.name] = e;
            if (s.datei) {
                const f = ers(s.datei);
                aus.dateien[s.name] = fs.existsSync(f) ? duenn(JSON.parse(fs.readFileSync(f, "utf8"))) : null;
            }
            console.log("  " + s.name + " · Exit " + r.status + (e.json ? "" : " · " + String(e.rest).trim().split("\n").slice(-1)[0]));
            if (s.muss && r.status !== 0)
                throw Object.assign(new Error(s.name + ": Exit " + r.status + " " + String(e.rest || "").slice(-300)), {
                    messort: s.name + ": " + (e.json && typeof e.json.fehler === "string" ? e.json.fehler : String(e.rest || "").trim().split("\n").slice(-1)[0] || "Exit " + r.status),
                });
        }
    } catch (e) {
        aus.fehler = String((e && e.message) || e);
        aus.messort = String((e && e.messort) || "Folge: " + aus.fehler).replace(/\s+/g, " ").slice(0, 300);
        code = 1;
    } finally {
        fs.writeFileSync(AUS, JSON.stringify(aus, null, 1));
    }
    console.log(aus.adapter || "[linse-gpu] ungenannt");
    // jeder Wurf der Folge fällt VOR dem Urteil der Linse (sie urteilt erst in punkte.cjs über die ganze Ausgabe): ein `muss`-Schritt,
    // ein Feld, das ein früherer Schritt nicht trug, ein Blob, das Log der Sitzung — die EINE Marke des Messorts (punkte.cjs keinUrteil (d))
    console.log(aus.fehler ? "@@PUNKTE@@ MESSORT " + aus.messort : "FOLGE " + plan.name + ": " + plan.schritte.length + " Schritte");
    process.exit(code);
})({"name":"karte2.planet.kosmos.welten#1","texte":{"ZENIT":"const st = r.state, cam = st.camera, sc = st.scene, W = 1920, H = 1080; const kam0 = [cam.position.clone(), cam.quaternion.clone(), cam.fov], pm = st.playerMesh.position, auge = new T.Vector3(pm.x, pm.y + 1.7, pm.z); const rc = new T.Raycaster(auge.clone(), new T.Vector3(0, 1, 0), 0.5, 5000); rc.layers.set(AnazhRealm.SHADOW_TWIN_LAYER); const treffer = rc.intersectObject(sc, true).filter((h) => !(h.object.name || '').startsWith('probe:') && h.object !== st.playerMesh).length; let u8 = null; cam.fov = 50; cam.updateProjectionMatrix(); cam.position.copy(auge); cam.lookAt(auge.x, auge.y + 100, auge.z - 0.01); cam.updateMatrixWorld(true); st.playerMesh.visible = false; try { for (let i = 0; i < 4; i++) u8 = (await window.__ausgabeAufnahme(W, H, 1, { satz: 'messung' })).u8; } finally { cam.fov = kam0[2]; cam.updateProjectionMatrix(); cam.position.copy(kam0[0]); cam.quaternion.copy(kam0[1]); cam.updateMatrixWorld(true); st.playerMesh.visible = true; } const lin = (v) => ((v /= 255), v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4)); const K = [[], [], []]; for (let y = Math.round(H * 0.4); y < Math.round(H * 0.6); y += 2) for (let x = Math.round(W * 0.4); x < Math.round(W * 0.6); x += 2) { const i = (y * W + x) * 4; for (let c = 0; c < 3; c++) K[c].push(lin(u8[i + c])); } const rgb = K.map((q) => q.sort((a, b) => a - b)[q.length >> 1]), G = st.worldMeta && st.worldMeta.gesetz; return { ende: 'ok', welt: st.worldMeta.worldId, uhr: st.timeOfDay, wetter: st.weather, frei: treffer === 0, treffer, n: K[0].length, rgb: rgb.map((v) => +v.toFixed(5)), blauRot: rgb[0] > 0 ? +(rgb[2] / rgb[0]).toFixed(4) : null, rayleighTiefe: G && G.himmel ? G.himmel.rayleighTiefe : null };","WARTE":"const loop = typeof window.__loop === 'function' ? window.__loop : null; if (loop) loop(true); let da = false; try { for (let i = 0; i < 1200 && !(da = r.state._weltbildDa > 0); i++) await new Promise((ok) => setTimeout(ok, 50)); for (let i = 0; i < 40; i++) await new Promise((ok) => requestAnimationFrame(ok)); } finally { if (loop) loop(false); }","TOR":"const st0 = r.state, idA = st0.worldMeta.worldId, t0 = performance.now(); const hol = r.obtainPortalForWorld('ferne'); if (!hol || !hol.ok) return { ok: false, grund: 'obtainPortalForWorld ' + (hol && hol.reason) }; const p = st0.playerMesh.position, e = r.spawnArchitecture(hol.blueprint, { x: p.x + 4, y: p.y, z: p.z }, { id: 'welten-k2-tor', precise: true }); if (!e || !(e.affordances && e.affordances.isPortal)) return { ok: false, grund: 'das Tor steht nicht als Portal' }; const res = r.enterPortal(e); if (!res || !res.ok) return { ok: false, grund: 'enterPortal ' + JSON.stringify(res) }; const erw = await r.erwacht; const loop = typeof window.__loop === 'function' ? window.__loop : null; if (loop) loop(true); let da = false; try { for (let i = 0; i < 1200 && !(da = r.state._weltbildDa > 0); i++) await new Promise((ok) => setTimeout(ok, 50)); for (let i = 0; i < 40; i++) await new Promise((ok) => requestAnimationFrame(ok)); } finally { if (loop) loop(false); } const st = r.state, G = st.worldMeta.gesetz; return { ok: erw === true && da && st !== st0 && st.worldMeta.worldId === res.worldId && res.worldId !== idA, a: idA, b: res.worldId, geboren: res.geboren === true, weltbild: da, s: +((performance.now() - t0) / 1000).toFixed(1), schwere: G ? G.schwere : null, rayleighTiefe: G && G.himmel ? G.himmel.rayleighTiefe : null };","HEIM":"const st0 = r.state, idB = st0.worldMeta.worldId; const h = (st0.architectures || []).find((a) => a && typeof a.id === 'string' && a.id.startsWith('heimtor-')); if (!h) return { ok: false, grund: 'kein Heimtor in ' + idB }; const res = r.enterPortal(h); if (!res || !res.ok) return { ok: false, grund: 'enterPortal ' + JSON.stringify(res) }; const erw = await r.erwacht; const loop = typeof window.__loop === 'function' ? window.__loop : null; if (loop) loop(true); let da = false; try { for (let i = 0; i < 1200 && !(da = r.state._weltbildDa > 0); i++) await new Promise((ok) => setTimeout(ok, 50)); for (let i = 0; i < 40; i++) await new Promise((ok) => requestAnimationFrame(ok)); } finally { if (loop) loop(false); } return { ok: erw === true && da && r.state.worldMeta.worldId !== idB, hier: r.state.worldMeta.worldId };"},"schritte":[{"name":"fenster","args":["fenster","1920","1080"],"muss":true},{"name":"umstellen","args":["umstellen","--ort","wiese"],"muss":true},{"name":"kugel-heim","probe":"@KOORD@/bericht/2110-messschuld2/kugel.js","blob":"2f71153039543f9f842d56ad19ad5dc0a1fed3ef","muss":true},{"name":"zenit-heim","args":["eval","@T:ZENIT@"]},{"name":"tor","args":["eval","@T:TOR@"]},{"name":"kugel-ferne","probe":"@KOORD@/bericht/2110-messschuld2/kugel.js","blob":"2f71153039543f9f842d56ad19ad5dc0a1fed3ef"},{"name":"zenit-ferne","args":["eval","@T:ZENIT@"]},{"name":"heim","args":["eval","@T:HEIM@"]}]}) C:\Users\micha\Desktop\AnazhRealm-OMEN\n0611-pm\meisterkarte-quelle\punkte\messung\roh\486a6685-gtx\karte2.planet.kosmos.welten_1.json C:\Users\micha\Desktop\AnazhRealm-OMEN\n0611-pm
