{
    "gesetz": "DIE EIN-SCHREIBER-WAND (gate:constitution, Teil 2): je Grundgröße EIN Schreiber. `muster` erkennt, wer eine Größe selbst erzeugt; `kanon` nennt je Datei die Anker des EINEN Schreibers; `zwillinge` nennt die Schuld von heute je Datei und Anker (Textstück der Treffer-Zeile, `×n` = n Treffer). Das Register ist keine Erlaubnis: es schrumpft nur — ein Treffer ohne Anker ist ROT, ein Anker ohne Treffer ist ROT (`--schrumpfen` streicht ihn). `frei` sind die Zeilen, an denen die Wand schweigen muss (Messung, Geburt einer Kennung).",
    "frei": [
        "const t0 = performance.now(); arbeit(); kosten.ms = performance.now() - t0;",
        "const id = \"w_\" + Math.random().toString(36).slice(2, 10) + Date.now().toString(36);",
        "const jetzt = performance.now() / 1000; if (jetzt - llm.zuletzt < llm.pauseS) return;",
        "const kamera = { blende: 8, belichtung: 1 / 60, iso: 100 };",
        "const k = st.renderer.toneMappingExposure > 0 ? st.renderer.toneMappingExposure : 1;",
        "if (this.state.gravity === 0 && this.state.timeOfDay >= 0.5) return this.state.spielZeit;",
        "const hoch = 9.812345 * 2, kante = 19.81, lenden = [17.2, 9.8, 10.6], STUFEN_GANG = 256, mu = z && z.mu > 0 ? z.mu : 0;"
    ],
    "muster": {
        "uhr-feld": {
            "groesse": "zeit",
            "rx": "\\.(?:timeOfDay|spielZeit|tagNull)\\s*[-+*/]?=(?!=)",
            "was": "schreibt Welt-Uhr, Tageszeit oder Null-Tag",
            "lies": "den Takt (`spielZeit += delta`), `_uhrSetzen`, `_weltGeburt`; eine Probe stellt die Uhr über `__buehne({ uhr })`",
            "beobachter": true,
            "mutant": "this.state.timeOfDay = 0.3;"
        },
        "laenge-fest": {
            "groesse": "zeit",
            "rx": "\\bPEGEL_TAG_S\\s*\\(\\)\\s*\\{|\\bseasonYearSeconds\\b[^\\n]*\\b2400\\b",
            "was": "eigene Tag- oder Jahr-Länge neben dem Tag-Regler",
            "lies": "`state.dayLengthMinutes` und `state.seasonYearSeconds` (EIN Kalender, Welle ZEIT)",
            "mutant": "const jahr = st.seasonYearSeconds > 0 ? st.seasonYearSeconds : 2400;"
        },
        "dt-kopie": {
            "groesse": "zeit",
            "rx": "(?<!belichtung:\\s*)(?<![\\w.])1\\s*/\\s*60(?![\\w.])",
            "was": "eigener fester Zeitschritt",
            "lies": "`AnazhRealm.FIXED_DT` oder das delta des Takts",
            "mutant": "const dt = 1 / 60;"
        },
        "eigene-uhr": {
            "groesse": "zeit",
            "rx": "new\\s+(?:THREE|T)\\.Clock\\b",
            "was": "eigene Uhr eines Labors",
            "lies": "die Uhr der Bühne (`AnazhHuelle.buehne`, `uhr`) oder `state.spielZeit`",
            "mutant": "const clock = new THREE.Clock();"
        },
        "wanduhr-phase": {
            "groesse": "zeit",
            "rx": "Math\\.(?:sin|cos)\\([^;\\n]*\\b(?:performance|Date)\\.now\\(\\)|(?:performance|Date)\\.now\\(\\)\\s*\\*\\s*(?:0?\\.\\d+|\\d+e-\\d)|\\b(?:const|let|var)\\s+t\\s*=\\s*(?:performance|Date)\\.now\\(\\)\\s*(?:/\\s*1(?:000|e3)|\\*)|\\.value\\s*=\\s*(?:performance|Date)\\.now\\(\\)",
            "was": "Wanduhr als Phase im Sim-Pfad (keine Kosten-Messung)",
            "lies": "`state.spielZeit` (die Bild-Uhr `_bildZeit`)",
            "mutant": "const t = performance.now() / 1000;"
        },
        "generator": {
            "groesse": "samen",
            "rx": "0x6d2b79f5|\\b1664525\\b|\\b1103515245\\b",
            "i": true,
            "was": "eigener Zufalls-Generator (mulberry32 oder LCG)",
            "lies": "den EINEN Strom `_samenStrom(_bauSame(name))`; ein Kern nimmt den gereichten Strom (Welle SAMEN: `samen(pfad)`)",
            "mutant": "a = (a + 0x6D2B79F5) | 0;"
        },
        "zufall": {
            "groesse": "samen",
            "rx": "Math\\.random\\b(?!\\(\\)\\.toString\\(36\\))",
            "was": "Math.random außerhalb der Geburt einer Kennung",
            "lies": "den EINEN Strom `_samenStrom(_bauSame(name))`",
            "mutant": "const wurf = Math.random() * 6;"
        },
        "belichtung": {
            "groesse": "licht",
            "rx": "\\.toneMapping(?:Exposure)?\\s*=(?!=)",
            "was": "setzt Belichtung oder Tonkurve selbst",
            "lies": "welt-licht.js `belichtung` und die Tonkurve der Bühne (`AnazhHuelle.buehne`); die Welt `_dayNightApplyBelichtung`",
            "beobachter": true,
            "mutant": "renderer.toneMappingExposure = 1.25;"
        },
        "eigenes-licht": {
            "groesse": "licht",
            "rx": "new\\s+(?:THREE|T)\\.(?:DirectionalLight|HemisphereLight|AmbientLight)\\b",
            "was": "eigene Sonne oder eigenes Füll-Licht",
            "lies": "die EINE Bühne (welt-licht.js `buehne`: Sonne, Umgebung, Belichtung)",
            "mutant": "const sonne = new THREE.DirectionalLight(0xffffff, 3);"
        },
        "schwere-literal": {
            "groesse": "kraft",
            "rx": "(?<![\\w.])9\\.81(?![\\w\\d])|\\b[gG]\\s*[:=]\\s*-?9\\.8\\b",
            "was": "Schwere als Literal",
            "lies": "`state.gravity` (aus `WELT_GESETZ_ERDE.schwere`, je Welt ihr Gesetz)",
            "mutant": "const g = 9.81;"
        },
        "schwere-feld": {
            "groesse": "kraft",
            "rx": "\\.gravity\\s*[-+*/]?=(?!=)",
            "was": "schreibt die Schwere der Welt",
            "lies": "das Welt-Gesetz (`_weltGesetz` → `state.gravity`) oder das DSL-Wort `gravity`",
            "beobachter": true,
            "mutant": "this.state.gravity = -3;"
        },
        "fall": {
            "groesse": "kraft",
            "rx": "\\bvy\\s*[-+]=\\s*[^;\\n]{1,40}\\*\\s*(?:dt|h|delta)\\b",
            "was": "eigener Fall-Integrator",
            "lies": "den Leib-Löser (koerper-core.js `leibFall`) mit `state.gravity`",
            "mutant": "p.vy -= 12 * dt;"
        },
        "bahn": {
            "groesse": "kraft",
            "rx": "\\b(?:\\w+\\.)*(?:x|y|z|pos\\w*|position)\\s*\\+=\\s*[^;\\n]{0,24}\\bv\\w*(?:\\.\\w+)?\\s*\\*\\s*(?:dt|h|delta)\\b",
            "was": "eigener Bahn-Integrator (Ort += Tempo · dt)",
            "lies": "den Leib-Löser (koerper-core.js `leibFall`, im Stamm `_leibTakt`)",
            "mutant": "p.x += p.vx * dt;"
        },
        "reibung": {
            "groesse": "stoff",
            "rx": "(?<![\\w.])(?:mu|reibung|maxGrip|gripK)\\s*:\\s*\\d+(?:\\.\\d+)?\\b",
            "was": "eigene Reib- oder Haft-Zahl",
            "lies": "die Stoff-Zeile (`_stoff(name)`: mu, muRad, muRadNass)",
            "mutant": "const eis = { mu: 0.05 };"
        },
        "haftung-aus-sicht": {
            "groesse": "stoff",
            "rx": "\\bmu\\w*\\([^\\n]*\\bgruen\\b|\\bgruen\\b[^\\n]*\\bmu\\w*\\(",
            "was": "Haftung aus der Sicht-Deckung des Bodens statt aus dem Stoff",
            "lies": "den Stoff des Bodens (`_terrainMaterialAt` → `_stoff`)",
            "mutant": "m += (mu(\"gras\", k) - m) * gruen;"
        },
        "augenhoehe": {
            "groesse": "mass",
            "rx": "\\b(?:eyeY|augeM|EGO_AUGE_M|kopfM|eyeHeight|mengeKoerperM)\\b\\s*[:=]\\s*1\\.\\d+",
            "was": "Augen- oder Körperhöhe als Literal",
            "lies": "`AnazhRealm.EGO_AUGE_M` (Welle SICHT: das Auge des Körpers, koerper-core)",
            "mutant": "const cfg = { eyeY: 1.62 };"
        },
        "frustum": {
            "groesse": "sicht",
            "rx": "new\\s+(?:THREE|T)\\.Frustum\\b",
            "was": "eigenes Frustum",
            "lies": "das Frustum des Takts (`_frustumCache`, stamm/dirigent-takt.js)",
            "beobachter": true,
            "mutant": "const fr = new THREE.Frustum();"
        },
        "stufen-tafel": {
            "groesse": "sicht",
            "rx": "\\b[A-Z_]*(?:STUFEN|LOD_DISTANCES|LOD_SCHIRM|STUFEN_BILD_PX)[A-Z_]*\\b\\s*=\\s*(?:Object\\.freeze\\(\\s*)?(?:[\\[{]|\\(\\(\\)\\s*=>)",
            "was": "eigene Stufen-Tafel",
            "lies": "`_lodAuge` und das Schirm-Gesetz `LOD_SCHIRM`",
            "mutant": "const WOLKEN_STUFEN = [0, 64, 256];"
        },
        "eigenes-ziel": {
            "groesse": "beobachter",
            "rx": "new\\s+\\w+\\.(?:WebGL)?RenderTarget\\b",
            "was": "eigenes Render-Ziel einer Probe (linear, ungetont)",
