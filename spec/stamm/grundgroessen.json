            "lies": "die Uhr der Bühne (`AnazhHuelle.buehne`, `uhr`) oder `state.spielZeit`",
            "mutant": "const clock = new THREE.Clock();"
        },
        "wanduhr-phase": {
            "groesse": "zeit",
            "rx": "Math\\.(?:sin|cos)\\([^;\\n]*\\b(?:performance|Date)\\.now\\(\\)|(?:performance|Date)\\.now\\(\\)\\s*\\*\\s*(?:0?\\.\\d+|\\d+e-\\d)|\\b(?:const|let|var)\\s+t\\s*=\\s*(?:performance|Date)\\.now\\(\\)\\s*(?:/\\s*1(?:000|e3)|\\*)|\\.value\\s*=\\s*(?:performance|Date)\\.now\\(\\)",
