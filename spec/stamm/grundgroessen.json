            "lies": "den Takt (`spielZeit += delta`), `_uhrSetzen`, `_weltGeburt`; eine Probe BESTELLT bei der Welt: die Stunde über `__buehne({ uhr })` oder `r._uhrSetzen(t, 'regler')`, die Welt-Uhr über `r._weltUhrNimm(t)` (nur vor) oder `r._weltUhrNeu(t)` (die Geburt)",
            "beobachter": true,
            "mutant": "this.state.timeOfDay = 0.3;"
        },
        "laenge-fest": {
            "groesse": "zeit",
            "rx": "\\bPEGEL_TAG_S\\b|\\bseasonYearSeconds\\b|\\b(?:jahreJeTag|stundeS|tagStunden)\\s*:\\s*\\d",
            "was": "eigene Tag- oder Jahr-Länge neben dem Tag-Regler",
            "lies": "den EINEN Kalender (`_kalender()`, `_kalenderZeit()`; das Gesetz `WELT_GESETZ_ERDE.kalender` in stamm/daten.js, Welle ZEIT)",
            "mutant": "const kalender = { jahreJeTag: 1.5 };"
        },
        "dt-kopie": {
            "groesse": "zeit",
            "rx": "(?<!belichtung:\\s*)(?<![\\w.])1\\s*/\\s*60(?![\\w.])",
